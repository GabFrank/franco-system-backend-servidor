{
  "branches": [
    { "name": "master" },
    { "name": "develop", "prerelease": "alpha" },
    { "name": "release/*", "prerelease": "beta" }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", {
      "prepareCmd": "./mvnw versions:set -DnewVersion=${nextRelease.version} -DgenerateBackupPoms=false -B && ./mvnw clean package -B -DskipTests -DskipFlyway=true -s .github/settings.xml"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "target/frc-central-server.jar", "label": "frc-central-server.jar" }
      ]
    }]
  ]
}
