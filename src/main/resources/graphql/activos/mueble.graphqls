type Mueble {
    id:ID!
    propietario: Persona
    identificador: String
    descripcion: String
    familia: FamiliaMueble
    tipoMueble: TipoMueble
    consumeEnergia: Boolean
    consumoValor: String
    valorTasacion: Float
    valorTasacionPyg: Float
    valorTasacionBrl: Float
    situacionPago: String
    proveedor: Proveedor
    moneda: Moneda
    montoTotal: Float
    montoYaPagado: Float
    cantidadCuotas: Int
    cantidadCuotasPagadas: Int
    diaVencimiento: Int
    creadoEn: Date
    usuario: Usuario
}

input MuebleInput {
    id:ID
    propietarioId: ID
    identificador: String
    descripcion: String
    familiaId: ID
    tipoMuebleId: ID
    consumeEnergia: Boolean
    consumoValor: String
    valorTasacion: Float
    valorTasacionPyg: Float
    valorTasacionBrl: Float
    situacionPago: String
    proveedorId: ID
    monedaId: ID
    montoTotal: Float
    montoYaPagado: Float
    cantidadCuotas: Int
    cantidadCuotasPagadas: Int
    diaVencimiento: Int
    usuarioId: ID
    cuotasDetalle: [CuotaDetalleInput]
}

type MueblePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Mueble]
    getPageable: Pageable
}

extend type Query {
    mueble(id:ID!):Mueble
    muebles(page:Int = 0, size:Int = 10):[Mueble]!
    countMueble: Int
    muebleSearch(texto:String):[Mueble]
    muebleSearchPage(texto: String, page: Int, size: Int): MueblePage
    mueblesByFamilia(familiaId:ID!):[Mueble]
}

extend type Mutation {
    saveMueble(mueble:MuebleInput!):Mueble!
    deleteMueble(id:ID!):Boolean!
}
