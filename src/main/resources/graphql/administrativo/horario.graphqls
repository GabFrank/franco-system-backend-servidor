type Horario {
    id: ID!
    descripcion: String
    horaEntrada: String
    horaSalida: String
    toleranciaMinutos: Int
    inicioDescanso: String
    finDescanso: String
    usuario: Usuario
    creadoEn: Date
    dias: [String]
    turno: Turno
}

"Resultado de copiar un horario a varios funcionarios (#523)."
type CopiaHorarioResultado {
    copiados: Int!
    "Uno por funcionario al que no se le pudo copiar, con el motivo."
    errores: [String]!
}

enum Turno {
    DIA
    NOCHE
    MADRUGADA
}

input HorarioInput {
    id: ID
    descripcion: String
    horaEntrada: String
    horaSalida: String
    toleranciaMinutos: Int
    inicioDescanso: String
    finDescanso: String
    usuarioId: Int
    dias: [String]
    turno: Turno
}

extend type Query {
    horario(id: ID!): Horario
    horarios(page: Int = 0, size: Int = 10): [Horario]!
    horariosPorUsuario(usuarioId: Int): [Horario]!
    "Los horarios que rigen para el funcionario, los mismos que usa la marcacion (#523)."
    horariosPorFuncionario(funcionarioId: Int!): [Horario]!
}

extend type Mutation {
    saveHorario(horario: HorarioInput!): Horario!
    deleteHorario(id: ID!): Boolean!
    "Guarda la tabla de horarios del usuario entera (#523): los que no vienen se quitan."
    saveHorariosUsuario(usuarioId: Int!, horarios: [HorarioInput]!): [Horario]!
    "Copia el horario a cada funcionario como horario propio (#523)."
    copiarHorario(horarioId: ID!, funcionarioIds: [Int]!): CopiaHorarioResultado!
    "Le quita un horario al funcionario: borra el propio, desvincula el compartido (#523)."
    quitarHorarioFuncionario(funcionarioId: Int!, horarioId: ID!): Funcionario
}
