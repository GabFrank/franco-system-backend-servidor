type Horario {
    id: ID!
    descripcion: String
    horaEntrada: String
    horaSalida: String
    toleranciaMinutos: Int
    inicioDescanso: String
    finDescanso: String
    usuario: Usuario
    creadoEn: Date
    dias: [String]
    turno: Turno
    "Cuantos funcionarios tienen asignado este horario (V284.3: se comparte, no se copia)."
    cantidadAsignados: Int
}

"Resultado de copiar un horario a varios funcionarios (#523)."
type CopiaHorarioResultado {
    copiados: Int!
    "Uno por funcionario al que no se le pudo copiar, con el motivo."
    errores: [String]!
}

"Pagina del catalogo de horarios (#772)."
type HorarioPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Horario]
    getPageable: Pageable
}

enum Turno {
    DIA
    NOCHE
    MADRUGADA
}

input HorarioInput {
    id: ID
    descripcion: String
    horaEntrada: String
    horaSalida: String
    toleranciaMinutos: Int
    inicioDescanso: String
    finDescanso: String
    usuarioId: Int
    dias: [String]
    turno: Turno
}

extend type Query {
    horario(id: ID!): Horario
    horarios(page: Int = 0, size: Int = 10): [Horario]!
    horariosPorUsuario(usuarioId: Int): [Horario]!
    "Todos los horarios que se pueden asignar, sin importar a quien (V284.3)."
    horariosCatalogo: [Horario]!
    "El mismo catalogo, paginado en el central para la pantalla Asignar Horario (#772)."
    horariosCatalogoPage(page: Int = 0, size: Int = 15): HorarioPage
    "Los horarios que rigen para el funcionario, los mismos que usa la marcacion (#523)."
    horariosPorFuncionario(funcionarioId: Int!): [Horario]!
}

extend type Mutation {
    saveHorario(horario: HorarioInput!): Horario!
    deleteHorario(id: ID!): Boolean!
    "Pantalla de antes de V284.3: asigna la tabla al usuario; los que no vienen se le quitan, sin borrarlos."
    saveHorariosUsuario(usuarioId: Int!, horarios: [HorarioInput]!): [Horario]!
    "Le asigna el mismo horario a cada funcionario, sin copiarlo (V284.3). copiados = asignados."
    asignarHorario(horarioId: ID!, funcionarioIds: [Int]!): CopiaHorarioResultado!
    "Nombre de antes de V284.3: hace lo mismo que asignarHorario."
    copiarHorario(horarioId: ID!, funcionarioIds: [Int]!): CopiaHorarioResultado!
    "Le asigna al funcionario un horario igual si ya existe, o lo crea (V284.3)."
    agregarHorarioFuncionario(funcionarioId: Int!, horario: HorarioInput!): Funcionario
    "Le quita un horario al funcionario; el horario sigue existiendo para los demas (V284.3)."
    quitarHorarioFuncionario(funcionarioId: Int!, horarioId: ID!): Funcionario
}
