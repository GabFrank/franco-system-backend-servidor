type Jornada {
    id: ID!
    sucursalId: ID!
    usuario: Usuario
    fecha: String
    
    marcacionEntrada: Marcacion
    marcacionSalida: Marcacion
    marcacionSalidaAlmuerzo: Marcacion
    marcacionEntradaAlmuerzo: Marcacion
    
    minutosTrabajados: Int
    minutosExtras: Int
    minutosLlegadaTardia: Int
    minutosLlegadaTardiaAlmuerzo: Int
    
    turno: Turno
    estado: EstadoJornada
    observacion: String
    actualizadoEn: String

    # Calculados en el central para el historial de marcaciones: el desktop solo los muestra.
    minutosLlegadaTardiaTotal: Int
    distanciaMaximaMetros: Int
    tieneUbicacion: Boolean
    puedeAjustarA8Horas: Boolean
}

type JornadaPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Jornada]
}

# Totales de TODO lo que cumple el filtro, no solo de la pagina.
type JornadaResumen {
    diasTrabajados: Int
    minutosTrabajados: Int
    minutosExtras: Int
    minutosLlegadaTardia: Int
}

type JornadaHistorial {
    pagina: JornadaPage
    resumen: JornadaResumen
}

enum EstadoJornada {
    NORMAL
    INCOMPLETO
    AUSENTE
}

enum AccionMarcacionPendiente {
    ENTRADA
    SALIDA
    RETORNO_ALMUERZO
    SALIDA_DEFINITIVA
}

type EstadoMarcacionUsuario {
    jornadaRelevante: Jornada
    accionPendiente: AccionMarcacionPendiente
    puedeMarcarEntrada: Boolean
    puedeMarcarSalida: Boolean
    puedeMarcarSalidaAlmuerzo: Boolean
    puedeMarcarEntradaAlmuerzo: Boolean
    estaEnJornada: Boolean
}

extend type Query {
    jornada(id: ID!, sucursalId: ID!): Jornada
    jornadasPorUsuario(usuarioId: ID!, fechaInicio: String, fechaFin: String): [Jornada]
    jornadas(fechaInicio: String, fechaFin: String, page: Int, size: Int): [Jornada]
    jornadasHistorial(usuarioId: ID, fechaInicio: String!, fechaFin: String!, turno: Turno, sucursalEntradaId: ID, sucursalSalidaId: ID, page: Int, size: Int): JornadaHistorial
    estadoMarcacionUsuario(usuarioId: ID!): EstadoMarcacionUsuario
}

extend type Mutation {
    ajustarJornadaA8Horas(id: ID!, sucursalId: ID!, observacion: String): Jornada
    guardarObservacionJornada(id: ID!, sucursalId: ID!, observacion: String!): Jornada
}
