type NotificacionPush {
    id: Int
    persona: Persona
    role: Role
    cargo: Cargo
    tipoCliente: TipoCliente
    titulo: String
    mensaje: String
    token: String
    data: String
    creadoEn: Date
}

input NotificacionPushInput {
    id: Int
    personaId: Int
    roleId: Int
    cargoId: Int
    tipoClienteId: Int
    titulo: String
    mensaje: String
    token: String
    data: String
    creadoEn: String
}

extend type Query {
    requestPushNotification(entity: NotificacionPushInput!): Boolean
    notificacionesUsuario(leidas: Boolean, page: Int, size: Int, estadoTablero: String, fechaInicio: String, fechaFin: String): NotificacionDestinatarioPage
    conteoNotificacionesNoLeidas: Int
    notificacionesPorToken(tokenFcm: String!): [NotificacionUsuario]
    notificacionesUsuarioLegacy(tokenFcm: String, leidas: Boolean, page: Int, size: Int, estadoTablero: String): NotificacionUsuarioPage
    comentariosNotificacion(notificacionId: Int!): [NotificacionComentario]
    conteoComentariosNotificacion(notificacionId: Int!): Int
    usuariosDestinatariosNotificacion(notificacionId: Int!): [Usuario]
    usuariosConAccesoNotificacion(notificacionId: Int!): [Usuario]
}

type Notificacion {
    id: Int
    titulo: String
    mensaje: String
    tipo: String
    data: String
    estadoTablero: String
    verificadoPorUsuario: Usuario
    fechaVerificacion: Date
    usuarioCreador: Usuario
    creadoEn: Date
    conteoComentarios: Int
}

type NotificacionComentario {
    id: Int
    notificacion: Notificacion
    usuario: Usuario
    comentario: String
    comentarioPadre: NotificacionComentario
    creadoEn: Date
    actualizadoEn: Date
}

type NotificacionDestinatario {
    id: Int
    notificacion: Notificacion
    usuario: Usuario
    leida: Boolean
    fechaLeida: Date
    fechaEntrega: Date
    creadoEn: Date
}

type NotificacionDestinatarioPage {
    content: [NotificacionDestinatario]
    pageNumber: Int
    pageSize: Int
    totalElements: Int
    totalPages: Int
}

type NotificacionUsuario {
    id: Int
    notificacion: Notificacion
    leida: Boolean
    fechaLeida: Date
    fechaEnvio: Date
    estadoEnvio: String
    interactuada: Boolean
    fechaInteraccion: Date
    accionRealizada: String
    estadoTablero: String
}

type NotificacionUsuarioPage {
    content: [NotificacionUsuario]
    pageNumber: Int
    pageSize: Int
    totalElements: Int
    totalPages: Int
}

  extend type Mutation {
      marcarNotificacionLeida(notificacionId: Int!): Boolean
      marcarTodasNotificacionesLeidas: Boolean
      cambiarEstadoTableroNotificacion(notificacionId: Int!, estado: String!): Boolean
      enviarNotificacionPersonalizada(titulo: String!, mensaje: String!, tipoEnvio: String!, usuariosIds: [Int]): Boolean
      registrarInteraccionNotificacion(notificacionUsuarioId: Int!, accion: String!): Boolean
      actualizarEstadoTableroNotificacion(notificacionUsuarioId: Int!, estado: String!): Boolean
      crearComentarioNotificacion(notificacionId: Int!, comentario: String!, comentarioPadreId: Int): NotificacionComentario
  }

