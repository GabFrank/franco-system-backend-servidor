type NotificacionPush {
    id: Int
    persona: Persona
    role: Role
    cargo: Cargo
    tipoCliente: TipoCliente
    titulo: String
    mensaje: String
    token: String
    data: String
    creadoEn: Date
}

input NotificacionPushInput {
    id: Int
    personaId: Int
    roleId: Int
    cargoId: Int
    tipoClienteId: Int
    titulo: String
    mensaje: String
    token: String
    data: String
    creadoEn: String
}

extend type Query {
    requestPushNotification(entity: NotificacionPushInput!): Boolean
    # Nueva API con estado compartido (sin tokenFcm)
    getNotificacionesUsuario(leidas: Boolean, page: Int, size: Int, estadoTablero: String): NotificacionDestinatarioPage
    getConteoNotificacionesNoLeidas: Int
    # API legacy (mantener para compatibilidad)
    notificacionesPorToken(tokenFcm: String!): [NotificacionUsuario]
    getNotificacionesUsuarioLegacy(tokenFcm: String, leidas: Boolean, page: Int, size: Int, estadoTablero: String): NotificacionUsuarioPage
}

type Notificacion {
    id: Int
    titulo: String
    mensaje: String
    tipo: String
    data: String
    # Campos nuevos: estado compartido
    estadoTablero: String
    verificadoPorUsuario: Usuario
    fechaVerificacion: Date
    usuarioCreador: Usuario
    creadoEn: Date
}

# Nueva entidad: NotificacionDestinatario (reemplaza NotificacionUsuario)
type NotificacionDestinatario {
    id: Int
    notificacion: Notificacion
    usuario: Usuario
    # Propiedades individuales
    leida: Boolean
    fechaLeida: Date
    fechaEntrega: Date
    creadoEn: Date
}

type NotificacionDestinatarioPage {
    content: [NotificacionDestinatario]
    pageNumber: Int
    pageSize: Int
    totalElements: Int
    totalPages: Int
}

# Entidad legacy (mantener para compatibilidad)
type NotificacionUsuario {
    id: Int
    notificacion: Notificacion
    leida: Boolean
    fechaLeida: Date
    fechaEnvio: Date
    estadoEnvio: String
    interactuada: Boolean
    fechaInteraccion: Date
    accionRealizada: String
    estadoTablero: String
}

type NotificacionUsuarioPage {
    content: [NotificacionUsuario]
    pageNumber: Int
    pageSize: Int
    totalElements: Int
    totalPages: Int
}

extend type Mutation {
    # Nueva API
    marcarNotificacionLeida(notificacionId: Int!): Boolean
    cambiarEstadoTableroNotificacion(notificacionId: Int!, estado: String!): Boolean
    # API legacy (mantener para compatibilidad)
    registrarInteraccionNotificacion(notificacionUsuarioId: Int!, accion: String!): Boolean
    actualizarEstadoTableroNotificacion(notificacionUsuarioId: Int!, estado: String!): Boolean
}

