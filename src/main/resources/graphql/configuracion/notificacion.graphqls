type NotificacionPush {
    id: Int
    persona: Persona
    role: Role
    cargo: Cargo
    tipoCliente: TipoCliente
    titulo: String
    mensaje: String
    token: String
    data: String
    creadoEn: Date
}

input NotificacionPushInput {
    id: Int
    personaId: Int
    roleId: Int
    cargoId: Int
    tipoClienteId: Int
    titulo: String
    mensaje: String
    token: String
    data: String
    creadoEn: String
}

extend type Query {
    requestPushNotification(entity: NotificacionPushInput!): Boolean
    notificacionesPorToken(tokenFcm: String!): [NotificacionUsuario]
    getNotificacionesUsuario(tokenFcm: String, leidas: Boolean, page: Int, size: Int, estadoTablero: String): NotificacionUsuarioPage
}

type Notificacion {
    id: Int
    titulo: String
    mensaje: String
    tipo: String
    data: String
    creadoEn: Date
}

type NotificacionUsuario {
    id: Int
    notificacion: Notificacion
    leida: Boolean
    fechaLeida: Date
    fechaEnvio: Date
    estadoEnvio: String
    interactuada: Boolean
    fechaInteraccion: Date
    accionRealizada: String
    estadoTablero: String
}

type NotificacionUsuarioPage {
    content: [NotificacionUsuario]
    pageNumber: Int
    pageSize: Int
    totalElements: Int
    totalPages: Int
}

extend type Mutation {
    marcarNotificacionLeida(notificacionUsuarioId: Int!): Boolean
    registrarInteraccionNotificacion(notificacionUsuarioId: Int!, accion: String!): Boolean
    actualizarEstadoTableroNotificacion(notificacionUsuarioId: Int!, estado: String!): Boolean
}

