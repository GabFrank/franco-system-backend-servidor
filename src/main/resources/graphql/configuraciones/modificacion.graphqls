type ModificacionRegistro {
    id: ID
    tipoEntidad: String
    entidadId: Int
    entidadSucursalId: Int
    schemaNombre: String
    tablaNombre: String
    tipoOperacion: TipoOperacion
    usuario: Usuario
    sucursal: Sucursal
    modificadoEn: Date
    creadoEn: Date
    ipAddress: String
    userAgent: String
    observacion: String
    activo: Boolean
    detalles: [ModificacionDetalle]
}

type ModificacionDetalle {
    id: ID
    modificacionRegistro: ModificacionRegistro
    campoNombre: String
    campoTipo: String
    valorAnterior: String
    valorNuevo: String
    valorAnteriorId: Int
    valorNuevoId: Int
    orden: Int
    esCampoSensible: Boolean
}

enum TipoOperacion {
    INSERT
    UPDATE
    DELETE
    SOFT_DELETE
}

type ModificacionRegistroPage {
    content: [ModificacionRegistro]
    pageNumber: Int
    pageSize: Int
    totalElements: Int
    totalPages: Int
}

extend type Query {
    modificacionRegistro(id: ID!): ModificacionRegistro
    modificacionesPorSchema(
        schemaNombre: String!
        inicio: Date!
        fin: Date!
        page: Int = 0
        size: Int = 15
    ): ModificacionRegistroPage
    modificacionesPorSchemas(
        schemaNombres: [String!]!
        inicio: Date!
        fin: Date!
        page: Int = 0
        size: Int = 15
    ): ModificacionRegistroPage
    modificacionesPorTipoEntidad(
        tipoEntidad: String!
        page: Int = 0
        size: Int = 15
    ): ModificacionRegistroPage
    modificacionesPorTipoEntidadAndSchema(
        tipoEntidad: String!
        schemaNombre: String!
        inicio: Date!
        fin: Date!
        page: Int = 0
        size: Int = 15
    ): ModificacionRegistroPage
    detallesModificacion(modificacionRegistroId: Int!): [ModificacionDetalle]
}


# Historial de cambios para administrativos: quién cambió qué, en palabras ("Cambió el precio").
type HistorialCambio {
    id: ID
    fecha: Date
    usuarioId: ID
    usuario: String
    categoria: String
    accion: String
    objeto: String
    observacion: String
    productoId: ID
    sinDetalle: Boolean
    resumen: String
    cambios: [HistorialCambioDetalle]
}

type HistorialCambioDetalle {
    campo: String
    antes: String
    despues: String
}

type HistorialCambioCategoria {
    codigo: String
    nombre: String
}

type HistorialCambioPage {
    getContent: [HistorialCambio]
    getTotalElements: Int
    getTotalPages: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
}

extend type Query {
    historialCambios(
        fechaInicio: String
        fechaFin: String
        usuarioId: ID
        productoId: ID
        categoria: String
        page: Int = 0
        size: Int = 25
    ): HistorialCambioPage
    historialCambiosCategorias: [HistorialCambioCategoria]
}
