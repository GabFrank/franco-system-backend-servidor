type Cargo {
    id:ID!
    nombre: String
    descripcion: String
    supervisadoPor: Cargo
    sueldoBase: Float
    creadoEn: Date
    usuario: Usuario
    subcargoList: [Cargo]
}

type CargoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Cargo]
    getPageable: Pageable
}

input CargoInput {
    id:ID
    nombre: String
    descripcion: String
    supervisadoPorId: Int
    sueldoBase: Float
    usuarioId: Int
}

extend type Query {
    cargo(id:ID!):Cargo
    cargos(page:Int = 0, size:Int = 10):[Cargo]!
    countCargo: Int
    cargosSearch(texto:String):[Cargo]
    cargosWithPage(page:Int = 0, size:Int = 25, texto:String):CargoPage

}

extend type Mutation {

    saveCargo(cargo:CargoInput!):Cargo!
    deleteCargo(id:ID!):Boolean!
}

