# Configuración de la IA (OpenAI o Claude) para leer facturas en papel. Las claves nunca vuelven completas.
type ConfiguracionIa {
    # Proveedor activo: OPENAI o CLAUDE
    proveedor: String!
    # OpenAI (nombres viejos, se mantienen por compatibilidad)
    claveCargada: Boolean!
    claveFinal: String
    modelo: String
    # Claude
    claudeClaveCargada: Boolean!
    claudeClaveFinal: String
    claudeModelo: String
    promptAdicional: String
    cifradoDisponible: Boolean!
}

extend type Query {
    configuracionIa: ConfiguracionIa!
}

extend type Mutation {
    # null = no cambia; en apiKey/claudeApiKey, "" = borra
    guardarConfiguracionIa(apiKey: String, modelo: String, promptAdicional: String,
                           proveedor: String, claudeApiKey: String, claudeModelo: String): ConfiguracionIa!
    # proveedor null = el activo
    probarConexionIa(proveedor: String): String!
}
