type CajaVirtual {
    id: ID!
    nombre: String
    tipo: CajaVirtualTipo
    sucursal: Sucursal
    responsable: Funcionario
    usuario: Usuario
    saldoGs: Float
    saldoRs: Float
    saldoDs: Float
    limiteGs: Float
    descripcion: String
    activo: Boolean
    creadoEn: Date
}

input CajaVirtualInput {
    id: ID
    nombre: String
    tipo: CajaVirtualTipo
    sucursalId: Int
    responsableId: Int
    usuarioId: Int
    saldoGs: Float
    saldoRs: Float
    saldoDs: Float
    limiteGs: Float
    descripcion: String
    activo: Boolean
}

type CajaVirtualPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [CajaVirtual]
}

# Saldo de efectivo por moneda de una caja (fuente de verdad: caja_virtual_saldo).
type CajaVirtualSaldoItem {
    moneda: Moneda
    saldo: Float
}

# Resumen de una cuenta bancaria para el sidebar del dashboard de caja.
type CuentaBancariaResumen {
    cuentaBancaria: CuentaBancaria
    saldo: Float
    saldoReservado: Float
    saldoFuturo: Float
}

extend type Query {
    cajaVirtual(id: ID!): CajaVirtual
    cajaVirtuales(page: Int = 0, size: Int = 10): CajaVirtualPage
    cajaVirtualesFilter(nombre: String, tipo: CajaVirtualTipo, sucursalId: Int, activo: Boolean, page: Int = 0, size: Int = 10): CajaVirtualPage
    cajaVirtualesPorTipo(tipo: CajaVirtualTipo!): [CajaVirtual]
    cajaVirtualesPorSucursal(sucursalId: ID!): [CajaVirtual]
    cajaVirtualesActivas: [CajaVirtual]
    cajaVirtualSaldos(cajaVirtualId: ID!): [CajaVirtualSaldoItem]
    cajaVirtualResumenBancario(cajaVirtualId: ID!): [CuentaBancariaResumen]
}

extend type Mutation {
    saveCajaVirtual(input: CajaVirtualInput!): CajaVirtual!
    deleteCajaVirtual(id: ID!): Boolean!
}

enum CajaVirtualTipo {
    CAJA_MAYOR
    CAJA_CHICA
}

# ── Acceso por caja (ACL) ──
#
# El rol de tesoreria habilita la capacidad; estas filas delimitan sobre que cajas (modelo AND).
# El propietario de la caja (CajaVirtual.usuario) tiene lectura y escritura implicitas y NO
# aparece en la lista: es quien la administra.

type CajaVirtualAcceso {
    id: ID!
    cajaVirtual: CajaVirtual
    usuario: Usuario
    puedeLeer: Boolean
    puedeEscribir: Boolean
    otorgadoPor: Usuario
    creadoEn: Date
}

extend type Query {
    # Usuarios habilitados en una caja. Solo el responsable de la caja (o ADMIN) puede verla.
    cajaVirtualAccesos(cajaVirtualId: ID!): [CajaVirtualAcceso]
}

extend type Mutation {
    # Otorga o actualiza el acceso de un usuario. Idempotente por (caja, usuario).
    otorgarAccesoCaja(cajaVirtualId: ID!, usuarioId: ID!, puedeLeer: Boolean, puedeEscribir: Boolean): CajaVirtualAcceso!
    revocarAccesoCaja(cajaVirtualId: ID!, usuarioId: ID!): Boolean!
    # Pasa la caja a otro responsable. Evita que quede huerfana si su duenio deja la empresa.
    transferirPropiedadCaja(cajaVirtualId: ID!, nuevoPropietarioId: ID!): CajaVirtual!
}
