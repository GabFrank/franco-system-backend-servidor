extend type Mutation {
    emitirCheque(
        chequeraId: Int!, total: Float!, diferido: Boolean!,
        monedaId: Int, cuentaBancariaId: Int, fechaPago: String, concepto: String,
        # La genera el cliente por cada intento del usuario y la reenvia al reintentar: un pedido repetido
        # con la misma clave devuelve el cheque ya emitido en vez de emitir otro.
        claveIdempotencia: String
    ): Cheque!
    cobrarCheque(chequeId: ID!): Cheque!
    anularCheque(chequeId: ID!, motivo: String): Cheque!

    crearAcreditacionPos(terminalPosId: Int!, montoOriginal: Float!, ventaId: Int): AcreditacionPos!
    verificarAcreditacionPos(id: ID!, montoReal: Float!): AcreditacionPos!
    procesarAcreditacionesPos: Int!
}

type AcreditacionPos {
    id: ID!
    montoOriginal: Float
    montoComision: Float
    montoEsperado: Float
    montoAcreditado: Float
    estado: String
    diferencia: Float
    fechaEsperadaAcreditacion: Date
    creadoEn: Date
}
