enum EstadoCheque { EMITIDO DIFERIDO COBRADO ANULADO }

type Cheque {
    id: ID!
    chequera: Chequera
    pagoDetalleCuota: PagoDetalleCuota
    numero: Float
    fechaEntrega: Date
    fechaPago: Date
    orden: String
    concepto: String
    diferido: Boolean
    total: Float
    beneficiario: String
    nominal: Boolean
    firmante: Persona
    estado: EstadoCheque
    moneda: Moneda
    cuentaBancaria: CuentaBancaria
    fechaCobro: Date
    motivoAnulacion: String
    creadoEn: Date
    usuario: Usuario
}

input ChequeInput {
    id: ID
    chequeraId: Int
    pagoDetalleCuotaId: Int
    numero: Float
    fechaEntrega: Date
    fechaPago: Date
    orden: String
    concepto: String
    diferido: Boolean
    total: Float
    firmanteId: Int
    usuarioId: Int
}

type ChequePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Cheque]
    getPageable: Pageable
}

extend type Query {
    cheque(id: ID!): Cheque
    cheques(page: Int = 0, size: Int = 10): [Cheque]!
    chequesSearch(texto: String): [Cheque]
    chequesPorChequeraId(chequeraId: ID!): [Cheque]
    chequePorPagoDetalleCuotaId(pagoDetalleCuotaId: ID!): Cheque
    countCheque: Int
}

extend type Mutation {
    saveCheque(entity: ChequeInput!): Cheque!
    deleteCheque(id: ID!): Boolean!
}

# ── Dashboard de cheques (todo por fecha de pago) ──
type ChequeResumenDia {
    fecha: String
    total: Float
    cantidad: Int
}

type ChequeSaldoChequera {
    chequera: Chequera
    cuentaBancaria: CuentaBancaria
    pendienteHastaFecha: Float
    saldoCuenta: Float
    saldoReservado: Float
    hojasDisponibles: Int
}

extend type Query {
    chequesDashboard(desde: String!, hasta: String!, cuentaBancariaId: ID, chequeraId: ID, estado: EstadoCheque): [Cheque]
    chequesResumenPorDia(desde: String!, hasta: String!, cuentaBancariaId: ID, chequeraId: ID, estado: EstadoCheque): [ChequeResumenDia]
    chequesSaldosPorChequera(hasta: String!, estado: EstadoCheque): [ChequeSaldoChequera]
}
