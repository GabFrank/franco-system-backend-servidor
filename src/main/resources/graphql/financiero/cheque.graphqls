enum EstadoCheque { EMITIDO DIFERIDO COBRADO ANULADO }

type Cheque {
    id: ID!
    chequera: Chequera
    pagoDetalleCuota: PagoDetalleCuota
    numero: Float
    fechaEntrega: Date
    fechaPago: Date
    orden: String
    concepto: String
    diferido: Boolean
    total: Float
    beneficiario: String
    nominal: Boolean
    firmante: Persona
    estado: EstadoCheque
    moneda: Moneda
    cuentaBancaria: CuentaBancaria
    fechaCobro: Date
    motivoAnulacion: String
    creadoEn: Date
    usuario: Usuario
    # Emisión completa (issue #601).
    proveedor: Proveedor
    # Id del primer cheque de su emisión en cuotas; null = emitido solo.
    loteId: Int
    # Evento de pago del que salió (null = emitido suelto) y «PAGO» / «MANUAL».
    pagoId: Int
    origen: String
    # Aviso de la emisión (fondos insuficientes en un EMITIDO). Solo en la respuesta de emitir.
    avisoFondos: String
}

input ChequeInput {
    id: ID
    chequeraId: Int
    pagoDetalleCuotaId: Int
    numero: Float
    fechaEntrega: Date
    fechaPago: Date
    orden: String
    concepto: String
    diferido: Boolean
    total: Float
    firmanteId: Int
    usuarioId: Int
}

type ChequePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Cheque]
    getPageable: Pageable
}

extend type Query {
    cheque(id: ID!): Cheque
    cheques(page: Int = 0, size: Int = 10): [Cheque]!
    chequesSearch(texto: String): [Cheque]
    chequesPorChequeraId(chequeraId: ID!): [Cheque]
    chequePorPagoDetalleCuotaId(pagoDetalleCuotaId: ID!): Cheque
    countCheque: Int
}

extend type Mutation {
    saveCheque(entity: ChequeInput!): Cheque!
    deleteCheque(id: ID!): Boolean!
}

# ── Dashboard de cheques (todo por fecha de pago) ──
type ChequeResumenDia {
    fecha: String
    total: Float
    cantidad: Int
}

type ChequeSaldoChequera {
    chequera: Chequera
    cuentaBancaria: CuentaBancaria
    pendienteHastaFecha: Float
    saldoCuenta: Float
    saldoReservado: Float
    hojasDisponibles: Int
}

extend type Query {
    # tipoFecha: EMISION | PAGO | COBRO (sin él, PAGO: lo de siempre). estados gana sobre estado; ninguno = todos.
    # texto busca en número, beneficiario y concepto. Hasta 500 cheques (los más nuevos).
    chequesDashboard(desde: String!, hasta: String!, cuentaBancariaId: ID, chequeraId: ID, estado: EstadoCheque,
                     tipoFecha: String, estados: [EstadoCheque], texto: String, proveedorId: ID): [Cheque]
    chequesResumenPorDia(desde: String!, hasta: String!, cuentaBancariaId: ID, chequeraId: ID, estado: EstadoCheque,
                         tipoFecha: String, estados: [EstadoCheque], texto: String, proveedorId: ID): [ChequeResumenDia]
    chequesSaldosPorChequera(hasta: String!, estado: EstadoCheque): [ChequeSaldoChequera]
}
