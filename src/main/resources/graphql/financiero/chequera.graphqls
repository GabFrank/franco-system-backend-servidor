enum EstadoChequera { ACTIVA AGOTADA ANULADA }

type Chequera {
    id: ID!
    cuentaBancaria: CuentaBancaria
    nombre: String
    firmantes: String
    rangoDesde: Float
    rangoHasta: Float
    siguienteNumero: Float
    estado: EstadoChequera
    hojasDisponibles: Int
    fechaRetiro: Date
    creadoEn: Date
    usuario: Usuario
    cheques: [Cheque]
}

input ChequeraInput {
    id: ID
    cuentaBancariaId: Int
    nombre: String
    firmantes: String
    rangoDesde: Float
    rangoHasta: Float
    siguienteNumero: Float
    estado: EstadoChequera
    fechaRetiro: Date
    usuarioId: Int
}

type ChequeraPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Chequera]
    getPageable: Pageable
}

# Un número de chequera que no se usa (issue #603). Vigente mientras revertidoEn sea null.
type ChequeraNumeroInutilizado {
    id: ID!
    chequera: Chequera
    numero: Float
    motivo: String
    usuario: Usuario
    creadoEn: Date
    cheque: Cheque
    accionCheque: AccionChequeInutilizado
    numeroNuevo: Float
    revertidoEn: Date
    revertidoPor: Usuario
}

enum AccionChequeInutilizado {
    NINGUNA
    ANULADO
    RENUMERADO
}

extend type Query {
    # Los próximos N números libres (sin cheque ni inutilizados): «Próximo Nº» y plan de cuotas.
    proximosNumerosCheque(chequeraId: ID!, cantidad: Int!): [Float!]!
    # Inutilizaciones de una chequera (vigentes y revertidas), o las vigentes de todas sin chequeraId.
    numerosInutilizados(chequeraId: ID): [ChequeraNumeroInutilizado]
    chequera(id: ID!): Chequera
    chequeras(page: Int = 0, size: Int = 10): [Chequera]!
    chequerasSearch(texto: String): [Chequera]
    chequerasPorCuenta(cuentaBancariaId: ID!, soloActivas: Boolean = true): [Chequera]
    countChequera: Int
}

extend type Mutation {
    saveChequera(entity: ChequeraInput!): Chequera!
    deleteChequera(id: ID!): Boolean!
    # accionCheque solo si el número tiene cheque: ANULADO (suelto) o RENUMERADO (a numeroNuevo, libre y en el rango).
    inutilizarNumeroCheque(chequeraId: ID!, numero: Float!, motivo: String!, accionCheque: AccionChequeInutilizado,
                           numeroNuevo: Float): ChequeraNumeroInutilizado!
    revertirInutilizacion(id: ID!): ChequeraNumeroInutilizado!
} 