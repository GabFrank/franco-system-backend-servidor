type ConfiguracionCobro {
    id: ID
    "true = el aumento del cobro no puede pasar aumentoTopePorcentaje del total; false = sin tope."
    aumentoConTope: Boolean!
    "Tope del aumento, en porcentaje del total del cobro (0, 100]."
    aumentoTopePorcentaje: Float!
    "true = el descuento del cobro (sumando los descuentos por item) no puede pasar descuentoTopePorcentaje del total; false = sin tope."
    descuentoConTope: Boolean!
    "Tope del descuento, en porcentaje del total del cobro (0, 100]."
    descuentoTopePorcentaje: Float!
    "Quien la guardo por ultima vez."
    usuarioNickname: String
    creadoEn: Date
    modificadoEn: Date
}

"Semantica PATCH: un campo que no viene NO pisa lo guardado. El usuario sale de la sesion."
input ConfiguracionCobroInput {
    aumentoConTope: Boolean
    aumentoTopePorcentaje: Float
    descuentoConTope: Boolean
    descuentoTopePorcentaje: Float
}

extend type Query {
    "Sin rol: la lee tambien el cobro del desktop web, sin filial local. Sin fila devuelve el default (con tope del 20%) sin guardarlo: id null."
    configuracionCobro: ConfiguracionCobro!
}

extend type Mutation {
    "Pide TESORERIA GESTIONAR."
    saveConfiguracionCobro(input: ConfiguracionCobroInput!): ConfiguracionCobro!
}
