type CuentaBancaria {
    id: ID!,
    persona: Persona,
    banco: Banco,
    moneda: Moneda,
    numero: String,
    nombre: String,
    tipoCuenta: TipoCuenta,
    saldo: Float,
    saldoReservado: Float,
    titular: String,
    alias: String,
    activo: Boolean,
    disponibleOperacionesFinancieras: Boolean,
    permiteSaldoNegativo: Boolean,
    creadoEn: Date
    usuario: Usuario
}

input CuentaBancariaInput {
    id:ID
    personaId: Int,
    bancoId: Int,
    monedaId: Int,
    numero: String,
    nombre: String,
    tipoCuenta: TipoCuenta,
    titular: String,
    alias: String,
    activo: Boolean,
    disponibleOperacionesFinancieras: Boolean,
    permiteSaldoNegativo: Boolean,
    usuarioId: Int
}

extend type Query {
    cuentaBancaria(id:ID!):CuentaBancaria
    cuentasBancarias(page:Int = 0, size:Int = 10):[CuentaBancaria]!
    cuentasBancariasOperables:[CuentaBancaria]!
    countCuentaBancaria: Int
}

extend type Mutation {
    saveCuentaBancaria(cuentaBancaria:CuentaBancariaInput!):CuentaBancaria!
    deleteCuentaBancaria(id:ID!):Boolean!
    # Corrige el saldo de la cuenta contra el extracto real. Deja un movimiento AJUSTE_POSITIVO
    # o AJUSTE_NEGATIVO con el motivo, que es la unica trazabilidad que tiene: un ajuste no
    # tiene contrapartida, es plata que aparece o desaparece del ledger.
    # saldoEsperado: el saldo que el cliente tenia en pantalla; si ya no es ese, se rechaza.
    # claveIdempotencia: el mismo pedido repetido devuelve el ajuste original en vez de aplicar otro.
    ajustarSaldoCuentaBancaria(cuentaBancariaId:ID!, monto:Float!, positivo:Boolean!, motivo:String!, saldoEsperado:Float, claveIdempotencia:String):MovimientoBancario!
}

enum TipoCuenta {
    CUENTA_CORRIENTE, CAJA_DE_AHORRO
}

