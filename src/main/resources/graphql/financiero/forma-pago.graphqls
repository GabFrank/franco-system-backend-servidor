type FormaPago {
    id:ID!
    descripcion: String
    movimientoCaja: Boolean
    activo: Boolean
    autorizacion: Boolean
    creadoEn: Date
    cuentaBancaria: CuentaBancaria
    usuario: Usuario
}

type FormaPagoEstadistica {
    formaPagoId: ID
    descripcion: String
    cantidadTransacciones: Int
    totalMonto: Float
    porcentaje: Float
}

input FormaPagoInput {
    id:Int
    descripcion: String
    movimientaCaja: Boolean
    activo: Boolean
    autorizacion: Boolean
    cuentaBancariaId: Int
    usuarioId: Int
}

extend type Query {
    formaPago(id:ID!):FormaPago
    formasPago(page:Int = 0, size:Int = 10):[FormaPago]!
    countFormaPago: Int
    formaPagoEstadisticas:[FormaPagoEstadistica]!
    formaPagoEstadisticasPorSucursal(sucursalId:ID!):[FormaPagoEstadistica]!
    formaPagoEstadisticasConFiltros(inicio:String, fin:String, sucursalId:ID):[FormaPagoEstadistica]!
}

extend type Mutation {
    saveFormaPago(formaPago:FormaPagoInput!):FormaPago!
    deleteFormaPago(id:ID!):Boolean!
}

