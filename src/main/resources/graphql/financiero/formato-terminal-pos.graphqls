type FormatoTerminalPos {
    id: ID!
    nombre: String
    proveedorServicio: ProveedorServicio
    "MAQUINA | WEB | API. Decide que camino se le ofrece al cajero y, sobre todo, cual se le cierra."
    tipo: String
    "Regex con grupos nombrados, anclado con ^ y $. Obligatorio para MAQUINA y WEB; solo API puede no tenerlo."
    patron: String
    """
    JSON: campo destino -> `{de, obligatorio, tipo}`.

    - `de`: el grupo nombrado del patrón del que sale el valor.
    - `obligatorio`: define también el formulario de carga a mano.
    - `tipo`: TEXTO | NUMERO | FECHA. Lo lee el filial: un valor que no encaja con su tipo se
      manda a revisión. **Declararlo es opcional y conviene ser conservador** — un campo sin tipo
      simplemente no se valida, mientras que un tipo mal puesto convierte lecturas correctas en
      sospechas, en cada venta. Ejemplo medido: el código de autorización de INFONET es
      alfanumérico en crédito (`D380AD`) y numérico en débito (`467769`), por la misma terminal;
      ahí corresponde TEXTO, o ninguno.

    Los campos destino que `venta_tarjeta` tiene como columna —`codigoAutorizacion`,
    `numeroBoleta`, `monto`, `terminal`, `identificadorTransaccion`, `moneda`— son
    **contenedores**: el proveedor le da el nombre que quiera a su dato y el mapeo decide en cuál
    cae. Lo que no mapea a ninguno va a `datos_extra`.
    """
    mapeo: String
    ejemplo: String
    "false = no elegible para asignar a terminales nuevas. Las que ya lo tienen siguen operando."
    activo: Boolean
    usuario: Usuario
    creadoEn: Date
}

input FormatoTerminalPosInput {
    id: ID
    nombre: String!
    proveedorServicioId: Int
    "MAQUINA | WEB | API"
    tipo: String!
    patron: String
    mapeo: String!
    ejemplo: String
    activo: Boolean
    usuarioId: Int
}

extend type Query {
    formatoTerminalPos(id: ID!): FormatoTerminalPos
    formatosTerminalPos: [FormatoTerminalPos]
    formatosTerminalPosActivos: [FormatoTerminalPos]
    formatosTerminalPosPorProveedor(proveedorServicioId: ID!): [FormatoTerminalPos]
    """
    Cuantas terminales usan este formato. La pantalla lo pide para avisar antes de que el usuario
    intente desactivarlo: desactivar uno en uso se rechaza.
    """
    terminalesQueUsanFormato(id: ID!): Int
}

extend type Mutation {
    saveFormatoTerminalPos(input: FormatoTerminalPosInput!): FormatoTerminalPos!
    desactivarFormatoTerminalPos(id: ID!): Boolean!
}
