type Moneda {
    id:ID!
    denominacion: String
    simbolo: String
    activo: Boolean
    principal: Boolean
    decimales: Int
    reglaRedondeo: String
    redondeoMultiplo: Float
    pais: Pais
    creadoEn: Date
    usuario: Usuario
    cambio: Float
    monedaBilleteList: [MonedaBilletes]
}

# Importes en guaranies expresados en una moneda. `montos` respeta el orden
# de los `montosGs` pedidos. Lo usa el kiosco de precios de la PWA.
type PreciosEnMoneda {
    moneda: Moneda
    decimales: Int
    montos: [Float]
}

input MonedaInput {
    id:Int
    denominacion: String
    simbolo: String
    activo: Boolean
    principal: Boolean
    decimales: Int
    reglaRedondeo: String
    redondeoMultiplo: Float
    paisId: Int
    usuarioId: Int
}

extend type Query {
    moneda(id:ID!):Moneda
#    monedaPorPais(paisId:ID): [Moneda]
    monedas(page:Int = 0, size:Int = 10):[Moneda]!
    monedasSearch(texto: String): [Moneda]
    countMoneda: Int
    convertirPreciosMobile(montosGs: [Float]!): [PreciosEnMoneda]
}

extend type Mutation {

    saveMoneda(moneda:MonedaInput!):Moneda!
    deleteMoneda(id:ID!):Boolean!
}

