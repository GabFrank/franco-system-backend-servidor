# Nota de Credito Electronica (NCE, iTiDE 5).
# El enum es espejo del enum Java de domain/financiero/enums; SchemaEnumsSincronizadosTest falla
# el build si se desincronizan.

enum MotivoEmisionNotaCredito {
    DEVOLUCION_Y_AJUSTES_DE_PRECIOS
    DEVOLUCION
    DESCUENTO
    BONIFICACION
    CREDITO_INCOBRABLE
    RECUPERO_DE_COSTO
    RECUPERO_DE_GASTO
    AJUSTE_DE_PRECIO
}

type NotaCredito {
    id: ID!
    sucursalId: Int
    timbradoDetalleId: Int
    numeroNotaCredito: Int
    fecha: Date
    facturaLegalId: Int
    motivoEmision: MotivoEmisionNotaCredito
    descripcionMotivo: String
    clienteId: Int
    nombre: String
    ruc: String
    direccion: String
    monedaExtranjera: String
    tipoCambio: Float
    ivaParcial0: Float
    ivaParcial5: Float
    ivaParcial10: Float
    totalParcial0: Float
    totalParcial5: Float
    totalParcial10: Float
    descuento: Float
    totalFinal: Float
    activo: Boolean
    usuarioId: Int
    creadoEn: Date
}

type NotaCreditoItem {
    id: ID!
    sucursalId: Int
    notaCreditoId: Int
    facturaLegalItemId: Int
    productoId: Int
    presentacionId: Int
    descripcion: String
    cantidad: Float
    unidadMedida: String
    precioUnitario: Float
    total: Float
    iva: Int
}

type NotaCreditoPage {
    getContent: [NotaCredito]
    getTotalElements: Int
    getTotalPages: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
}

"""
Una factura que hoy admite nota de credito. Los datos son para que el operador CONFIRME que
eligio la correcta: al emitir desde un buscador se tiene menos contexto que desde el menu de una
factura concreta, y una NC aprobada es irreversible.
"""
type FacturaParaNotaCredito {
    facturaLegalId: ID!
    sucursalId: ID!
    numeroFactura: Int
    fecha: String
    cliente: String
    ruc: String
    total: Float
    moneda: String
    """Nombre de la sucursal que emitio la factura (la que emite la nota)."""
    sucursal: String
}

extend type Query {
    notaCredito(id: ID!, sucursalId: ID!): NotaCredito
    notaCreditos(sucursalId: ID, fechaInicio: String, fechaFin: String, page: Int!, size: Int!): NotaCreditoPage
    notaCreditoItems(notaCreditoId: ID!, sucursalId: ID!): [NotaCreditoItem]
    notaCreditosPorFactura(facturaLegalId: ID!, sucursalId: ID!): [NotaCredito]
    documentoElectronicoDeNotaCredito(notaCreditoId: ID!, sucursalId: ID!): DocumentoElectronico
    """KuDE en PDF (base64). anchoMm y escpos quedan para el ticket termico, que todavia no esta."""
    imprimirNotaCredito(id: ID!, sucursalId: ID!, anchoMm: Int, escpos: Boolean): String
    """
    Facturas que hoy admiten nota de credito. Filtra los CINCO requisitos que exige
    crearNotaCreditoDesdeFactura, para que el buscador no ofrezca una que va a fallar al emitir.
    Sin sucursalId busca en todas: el central (SERVIDOR) no tiene facturas propias.
    """
    facturasParaNotaCredito(sucursalId: ID, numero: String, page: Int!, size: Int!): [FacturaParaNotaCredito!]!
}

extend type Mutation {
    """Crea la nota de credito TOTAL de una factura electronica aprobada: copia sus items y totales."""
    crearNotaCreditoDesdeFactura(facturaLegalId: ID!, sucursalId: ID!, motivo: String!, descripcionMotivo: String, usuarioId: ID): NotaCredito!
    generarYEnviarNotaCredito(id: ID!, sucursalId: ID!): DocumentoElectronico
    reenviarNotaCredito(id: ID!, sucursalId: ID!): DocumentoElectronico
    anularNotaCredito(id: ID!, sucursalId: ID!): NotaCredito
}
