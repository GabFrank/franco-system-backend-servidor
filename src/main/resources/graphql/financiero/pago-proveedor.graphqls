enum FuentePago {
    CAJA_MAYOR
    CUENTA_BANCARIA
    CHEQUE
    AJUSTE
}

input LineaPagoInput {
    fuente: FuentePago!
    cajaVirtualId: Int
    cuentaBancariaId: Int
    monedaId: Int
    monto: Float!
    cotizacion: Float
    montoSolicitud: Float
    descuento: Boolean
    aumento: Boolean
    # Fuente CHEQUE (1 cheque por chequeRef, aunque el FIFO reparta la línea entre notas)
    chequeRef: Int
    chequeraId: Int
    diferido: Boolean
    fechaEmision: String
    fechaPago: String
    beneficiario: String
    nominal: Boolean
}

input PagoLoteInput {
    solicitudId: ID!
    monedaId: ID!
    monto: Float!
}

input SolicitudConLineasInput {
    solicitudId: ID!
    lineas: [LineaPagoInput!]!
}

input GastoParaPagoInput {
    tipoGastoId: ID
    descripcion: String
    monedaId: ID!
    monto: Float!
    beneficiarioProveedorId: ID
    beneficiarioPersonaId: ID
    fechaVencimiento: String
    sucursalId: ID
    # Funcionario responsable del gasto. Opcional.
    responsableId: ID
}

# Una linea del desglose de un evento de pago. Existe porque el evento postea UN movimiento
# consolidado en la caja: su descripcion no puede nombrar a los N documentos pagados.
type DetallePagoItem {
    solicitudPagoId: ID!
    # COMPRA | GASTO | RRHH
    tipo: String
    descripcion: String
    proveedorNombre: String
    monedaDenominacion: String
    monedaSimbolo: String
    decimales: Int
    # Monto imputado a este documento en este evento.
    montoImputado: Float
    montoTotal: Float
    montoPagado: Float
    estado: String
}

extend type Query {
    solicitudesPagoPendientes(proveedorId: ID): [SolicitudPago]
    gastosPendientes: [SolicitudPago]
    # Desglose de un evento de pago: que documentos se pagaron y cuanto se imputo a cada uno.
    detalleDePago(pagoId: ID!): [DetallePagoItem]
}

extend type Mutation {
    pagarSolicitud(solicitudId: ID!, lineas: [LineaPagoInput!]!): SolicitudPago!
    pagarSolicitudesLoteCajaMayor(cajaVirtualId: ID!, pagos: [PagoLoteInput!]!): Pago
    # claveIdempotencia: la genera el cliente por cada intento del usuario y la reenvia al reintentar.
    # Un pedido repetido con la misma clave devuelve el pago ya creado en vez de registrarlo otra vez.
    pagarSolicitudesMixto(pagos: [SolicitudConLineasInput!]!, claveIdempotencia: String): Pago
    anularPagoCpp(pagoId: ID!, motivo: String): Pago!
    # Asigna una solicitud pagable (compra o gasto) a una caja para que la pague su operador.
    # cajaVirtualId null = quitar la asignación.
    asignarSolicitudPagoACaja(solicitudPagoId: ID!, cajaVirtualId: ID): SolicitudPago!
    crearGastoParaPago(input: GastoParaPagoInput!, claveIdempotencia: String): SolicitudPago!
}
