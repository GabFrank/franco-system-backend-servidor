enum FuentePago {
    CAJA_MAYOR
    CUENTA_BANCARIA
    CHEQUE
    AJUSTE
}

input LineaPagoInput {
    fuente: FuentePago!
    cajaVirtualId: Int
    cuentaBancariaId: Int
    monedaId: Int
    monto: Float!
    cotizacion: Float
    montoSolicitud: Float
    descuento: Boolean
    aumento: Boolean
}

input PagoLoteInput {
    solicitudId: ID!
    monedaId: ID!
    monto: Float!
}

input SolicitudConLineasInput {
    solicitudId: ID!
    lineas: [LineaPagoInput!]!
}

extend type Query {
    solicitudesPagoPendientes(proveedorId: ID): [SolicitudPago]
}

extend type Mutation {
    pagarSolicitud(solicitudId: ID!, lineas: [LineaPagoInput!]!): SolicitudPago!
    pagarSolicitudesLoteCajaMayor(cajaVirtualId: ID!, pagos: [PagoLoteInput!]!): Pago
    pagarSolicitudesMixto(pagos: [SolicitudConLineasInput!]!): Pago
    anularPagoCpp(pagoId: ID!, motivo: String): Pago!
}
