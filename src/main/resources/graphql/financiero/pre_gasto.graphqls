enum EstadoPreGasto {
    PENDIENTE
    TRAMITE
    AUTORIZADO
    RECHAZADO
    COMPLETADO
    ENVIADO_A_TESORERIA
}

type PreGastoDetalleFinanzas {
    id: ID
    moneda: Moneda
    formaPago: String
    monto: Float
    creadoEn: Date
}

type PreGasto {
    id: ID!
    sucursalId: Int
    funcionario: Persona
    ente: Ente
    tipoGasto: TipoGasto
    descripcion: String
    moneda: Moneda
    montoSolicitado: Float
    sucursalCaja: Sucursal
    cajaId: ID
    estado: EstadoPreGasto
    qrToken: String
    autorizadoPor: Persona
    delegadoA: Persona
    motivoRechazo: String
    montoRetirado: Float
    montoGastado: Float
    saldoDevolver: Float
    montoPendienteRetiro: Float
    montoNoRendido: Float
    porcentajeRendicion: Float
    desvioVsSolicitado: Float
    estadoEtiqueta: String
    estadoIcono: String
    estadoColor: String
    usuario: Usuario
    solicitudPagoId: ID
    beneficiarioProveedor: Proveedor
    beneficiarioPersona: Persona
    fechaVencimiento: Date
    nivelUrgencia: String
    observaciones: String
    finanzas: [PreGastoDetalleFinanzas]
    creadoEn: Date
}

type EnteFinancialSummary {
    enteId: ID
    descripcion: String
    montoTotal: Float
    montoYaPagado: Float
    montoPendiente: Float
    cuotasTotales: Int
    cuotasPagadas: Int
    cuotasFaltantes: Int
    diaVencimiento: Int
    diasParaVencer: Int
    estadoCuota: String
    monedaSimbolo: String
    monedaId: ID
    proveedorNombre: String
    tipoGastoSugeridoId: String
    situacionPago: String
    porcentajePagado: Float
    montoSugerido: Float
    descripcionSugerida: String
}

input PreGastoDetalleFinanzasInput {
    id: ID
    preGastoId: ID
    sucursalId: ID
    monedaId: Int
    formaPago: String
    monto: Float
}

input PreGastoInput {
    id: ID
    sucursalId: Int
    funcionarioId: Int
    enteId: Int
    tipoGastoId: Int
    descripcion: String
    monedaId: Int
    montoSolicitado: Float
    sucursalCajaId: Int
    cajaId: Int
    estado: EstadoPreGasto
    autorizadoPorId: Int
    delegadoAId: Int
    motivoRechazo: String
    montoRetirado: Float
    usuarioId: Int
    creadoEn: Date
    nivelUrgencia: String
    observaciones: String
    beneficiarioProveedorId: Int
    beneficiarioPersonaId: Int
    fechaVencimiento: String
    finanzas: [PreGastoDetalleFinanzasInput]
}

type PreGastoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [PreGasto]
    getPageable: Pageable
}

extend type Query {
    preGasto(id: ID!, sucId: ID): PreGasto
    preGastos(estado: String, sucId: ID): [PreGasto]!
    preGastosPorSucursal(estado: String!, sucursalId: Int!): [PreGasto]!
    preGastosPorFuncionario(funcionarioId: Int!): [PreGasto]!
    preGastosSearch(texto: String!, sucId: ID): [PreGasto]!
    filterPreGastos(id: ID, cajaId: ID, estado: String, estados: [String], inicio: String, fin: String, page: Int, size: Int): PreGastoPage
    imprimirPreGasto(id: ID!, sucId: ID): String
    getEnteFinancialSummary(enteId: ID!): EnteFinancialSummary
}

extend type Mutation {
    savePreGasto(entity: PreGastoInput!): PreGasto!
    autorizarPreGasto(id: ID!, autorizadorId: ID!, sucId: ID): PreGasto
    rechazarPreGasto(id: ID!, motivo: String!, sucId: ID): PreGasto
    tramitarPreGasto(id: ID!, sucId: ID): PreGasto
    completarPreGasto(id: ID!, sucId: ID): PreGasto
    enviarPreGastoATesoreria(id: ID!, sucId: ID, usuarioId: ID): PreGasto
    deletePreGasto(id: ID!, sucId: ID): Boolean!
}
