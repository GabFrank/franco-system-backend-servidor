# Ventas facturadas de un mes para el contador: exentas, gravadas 5 % y 10 % (base sin IVA e IVA).
# Papel y electronicas por igual; las anuladas no suman. sucIds vacio o null = todas.
type ResumenFiscalVentas {
    anio: Int
    mes: Int
    periodo: String
    sucursalesFiltro: String
    contribuyentes: [ResumenFiscalContribuyente]
}

type ResumenFiscalContribuyente {
    ruc: String
    razonSocial: String
    gravada10: Float
    iva10: Float
    gravada5: Float
    iva5: Float
    exentas: Float
    totalBase: Float
    totalIva: Float
    totalFacturado: Float
    emitidas: Int
    anuladas: Int
    rechazadas: Int
    montoRechazadas: Float
    detalle: [ResumenFiscalTimbrado]
}

type ResumenFiscalTimbrado {
    sucursalId: ID
    sucursal: String
    timbrado: String
    electronico: Boolean
    tipo: String
    establecimiento: String
    puntoExpedicion: String
    numeroDesde: String
    numeroHasta: String
    emitidas: Int
    anuladas: Int
    rechazadas: Int
    montoRechazadas: Float
    gravada10: Float
    iva10: Float
    gravada5: Float
    iva5: Float
    exentas: Float
    totalFacturado: Float
}

extend type Query {
    resumenFiscalVentas(anio: Int!, mes: Int!, sucIds: [ID]): ResumenFiscalVentas
    # PDF en base64
    imprimirResumenFiscalVentas(anio: Int!, mes: Int!, sucIds: [ID]): String
}
