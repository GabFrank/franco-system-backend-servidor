type SaldoTesoreria {
    monedaId: Int
    moneda: String
    efectivo: Float
    banco: Float
    bancoReservado: Float
    # banco − bancoReservado: lo libre, descontados los cheques diferidos y al día emitidos.
    bancoDisponible: Float
    total: Float
    # efectivo + bancoDisponible.
    totalDisponible: Float
}

type VencimientoTesoreria {
    tipo: String
    referenciaId: Int
    descripcion: String
    monto: Float
    fecha: Date
    diasRestantes: Int
}

type AgingTesoreria {
    porVencer: Float
    vencido: Float
}

extend type Query {
    saldoConsolidadoTesoreria: [SaldoTesoreria]
    proximosVencimientosTesoreria(dias: Int = 30): [VencimientoTesoreria]
    agingCppTesoreria: AgingTesoreria
}
