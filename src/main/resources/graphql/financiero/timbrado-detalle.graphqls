type TimbradoDetalle {
    id:ID!
    timbrado: Timbrado
    puntoDeVenta: PuntoDeVenta
    puntoExpedicion: String
    cantidad: Int
    rangoDesde: Int
    rangoHasta: Int
    numeroActual: Int
    activo: Boolean
    creadoEn: Date
    sucursal: Sucursal
    usuario: Usuario
    departamento: String
    ciudad: String
    codigoCiudad: String
    localidad: String
    barrio: String
    direccion: String
    telefono: String
}

input TimbradoDetalleInput {
    id:ID
    timbradoId: Int
    puntoDeVentaId: Int
    puntoExpedicion: String
    cantidad: Int
    rangoDesde: Int
    rangoHasta: Int
    numeroActual: Int
    activo: Boolean
    usuarioId: Int
    sucursalId: Int
    departamento: String
    ciudad: String
    codigoCiudad: String
    localidad: String
    barrio: String
    direccion: String
    telefono: String
}

type TimbradoDetallePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [TimbradoDetalle]
    getPageable: Pageable
}

extend type Query {
    timbradoDetalle(id:ID!):TimbradoDetalle
    timbradoDetalles(page:Int = 0, size:Int = 10):[TimbradoDetalle]!
    countTimbradoDetalle: Int
}

extend type Mutation {
    saveTimbradoDetalle(timbradoDetalle:TimbradoDetalleInput!):TimbradoDetalle!
    deleteTimbradoDetalle(id:ID!):Boolean!
}

