enum TipoNaturalezaGasto {
    VARIABLE
    CONTINUO
    RECURRENTE
}

enum TipoPadreGastoModulo {
    MUEBLE
    INMUEBLE
    PERSONAS
    VEHICULO
    EQUIPOS
    ANDE
    JUNTA_SANEAMIENTO
    IMPUESTO
    INTERNET
    SEGURIDAD
    BASURA
    SEGURO
    OTRO
}

type TipoGasto {
    id:ID!
    descripcion: String
    tipoNaturaleza: TipoNaturalezaGasto
    moduloPadre: TipoPadreGastoModulo
    autorizacion: Boolean
    cargo: Cargo
    activo: Boolean
    activoEnSucursales: Boolean
    creadoEn: Date
    usuario: Usuario
    afectaFinanzasActivo: Boolean
    esPagoCuotaActivo: Boolean
}

type ModuloGastoInfo {
    valor: TipoPadreGastoModulo
    etiqueta: String
    grupo: String
    esServicioContinuo: Boolean
    tieneCuotasActivo: Boolean
    requiereEnteActivo: Boolean
    tipoEnteEsperado: String
    diaVencimientoEnContinuo: Boolean
    lecturaMedidorEnContinuo: Boolean
    nisEnContinuo: Boolean
}

input TipoGastoInput {
    id:ID
    descripcion: String
    tipoNaturaleza: TipoNaturalezaGasto
    moduloPadre: TipoPadreGastoModulo
    autorizacion: Boolean
    cargoId: Int
    activo: Boolean
    activoEnSucursales: Boolean
    afectaFinanzasActivo: Boolean
    esPagoCuotaActivo: Boolean
    creadoEn: Date
    usuarioId: Int
}

type TipoGastoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [TipoGasto]
    getPageable: Pageable
}

extend type Query {
    tipoGasto(id:ID!):TipoGasto
    tipoGastosSearch(texto: String):[TipoGasto]
    tipoGastos(page:Int = 0, size:Int = 10):[TipoGasto]!
    countTipoGasto: Int
    filterTipoGastos(naturaleza: String, texto: String, moduloPadre: TipoPadreGastoModulo, page: Int, size: Int): TipoGastoPage
    modulosGasto: [ModuloGastoInfo!]!
}

extend type Mutation {
    saveTipoGasto(tipoGasto:TipoGastoInput!):TipoGasto!
    deleteTipoGasto(id:ID!):Boolean!
}

