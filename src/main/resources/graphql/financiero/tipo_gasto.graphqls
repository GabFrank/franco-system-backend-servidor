enum TipoNaturalezaGasto {
    VARIABLE
    CONTINUO
    RECURRENTE
}

type TipoGasto {
    id:ID!
    isClasificacion: Boolean
    clasificacionGasto: TipoGasto
    descripcion: String
    tipoNaturaleza: TipoNaturalezaGasto
    autorizacion: Boolean
    cargo: Cargo
    activo: Boolean
    creadoEn: Date
    usuario: Usuario
    subtipoList: [TipoGasto]
}

input TipoGastoInput {
    id:ID
    isClasificacion: Boolean
    clasificacionGastoId: Int
    descripcion: String
    tipoNaturaleza: TipoNaturalezaGasto
    autorizacion: Boolean
    cargoId: Int
    activo: Boolean
    creadoEn: Date
    usuarioId: Int
}

type TipoGastoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [TipoGasto]
    getPageable: Pageable
}

extend type Query {
    tipoGasto(id:ID!):TipoGasto
    tipoGastosSearch(texto: String):[TipoGasto]
    tipoGastos(page:Int = 0, size:Int = 10):[TipoGasto]!
    rootTipoGasto:[TipoGasto]!
    countTipoGasto: Int
    filterTipoGastos(naturaleza: String, texto: String, page: Int, size: Int): TipoGastoPage
}

extend type Mutation {
    saveTipoGasto(tipoGasto:TipoGastoInput!):TipoGasto!
    deleteTipoGasto(id:ID!):Boolean!
}

