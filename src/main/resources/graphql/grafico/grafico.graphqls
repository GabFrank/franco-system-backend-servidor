input PeriodoGraficoInput {
    etiqueta: String!
    inicio: String!
    fin: String!
}

enum GraficoExcelTipo {
    VENTA_CIUDAD
    VENTA_SUCURSAL
    VENTA_FUNCIONARIO
    FORMA_PAGO
    GASTO_CATEGORIA
    PRODUCTOS_VENDIDOS
    INGRESO_GASTO
    VENTAS_HORA
    DELIVERY_SUCURSAL
}

input GraficoExcelExportInput {
    periodos: [PeriodoGraficoInput!]
    sucIds: [ID]
    usuarioIds: [ID]
    anios: [Int!]
    filtroAnhos: String
    filtroMeses: String
    filtroRangoDias: String
    filtroSucursales: String
    filtroExtra: String
    limit: Int
    familiaId: ID
    subfamiliaId: ID
    ascendente: Boolean
    productoIds: [ID]
}

type DesglosePeriodoGrafico {
    etiqueta: String!
    total: Float!
    cantidad: Float
}

type DesgloseAnhoGrafico {
    anio: Int!
    total: Float!
    cantidad: Float
}

type IngresoGastoSerieGrafico {
    anio: Int!
    sucId: ID
    sucursalNombre: String
    ingresos: [VentaPorMes!]!
    gastos: [GastoPorMes!]!
}

type VentasPorHoraSerieGrafico {
    sucId: ID
    sucursalNombre: String
    etiqueta: String!
    fecha: String!
    datos: [VentaPorHora!]!
}

type VentaPorCiudad {
    ciudadId: ID
    nombre: String
    total: Float
    cantidadVentas: Float
    desglosePeriodos: [DesglosePeriodoGrafico!]
    desgloseAnhos: [DesgloseAnhoGrafico!]
}

type ConvenioConteo {
    total: Int!
    abiertas: Int!
    finalizadas: Int!
    canceladas: Int!
    otras: Int!
}

type ConvenioSucursalIntegridad {
    sucursalId: ID!
    sucursalNombre: String
    central: ConvenioConteo!
    filial: ConvenioConteo
    estadoIntegridad: String!
    error: String
    faltanEnCentral: Int!
    sobranEnCentral: Int!
    estadoDistinto: Int!
    idsFaltanEnCentral: [ID!]!
    idsSobranEnCentral: [ID!]!
    idsEstadoDistinto: [ID!]!
    ultimoCentral: String
    ultimoFilial: String
}

extend type Query {
    ventasPorFuncionarioMulti(
        periodos: [PeriodoGraficoInput!]!
        sucIds: [ID]
        usuarioIds: [ID]
    ): [VentaPorFuncionario!]!

    formaPagoEstadisticasMulti(
        periodos: [PeriodoGraficoInput!]!
        sucIds: [ID]
    ): [FormaPagoEstadistica!]!

    gastosPorCategoriaMulti(
        periodos: [PeriodoGraficoInput!]!
        sucIds: [ID]
    ): [GastoPorCategoria!]!

    ventasPorSucursalMulti(
        periodos: [PeriodoGraficoInput!]!
    ): [VentaPorSucursal!]!

    deliveryPorSucursalMulti(
        periodos: [PeriodoGraficoInput!]!
    ): [VentaPorSucursal!]!

    ventasPorCiudadMulti(
        periodos: [PeriodoGraficoInput!]!
    ): [VentaPorCiudad!]!

    exportarGraficoExcel(
        tipo: GraficoExcelTipo!
        input: GraficoExcelExportInput!
    ): String

    productosMasVendidosMulti(
        periodos: [PeriodoGraficoInput!]!
        sucIds: [ID]
        limit: Int
        familiaId: ID
        subfamiliaId: ID
        ascendente: Boolean
        productoIds: [ID]
    ): [ProductoVendidoEstadistica!]!

    ingresosGastosPorMesMulti(
        anios: [Int!]!
        sucIds: [ID]
    ): [IngresoGastoSerieGrafico!]!

    ventasPorHoraMulti(
        periodos: [PeriodoGraficoInput!]!
        sucIds: [ID]
    ): [VentasPorHoraSerieGrafico!]!

    "Convenios (ventas a crédito) por sucursal y comparación contra la base de cada filial. Fechas yyyy-MM-dd, ambas inclusive."
    convenioIntegridadPorSucursal(
        fechaInicio: String!
        fechaFin: String!
        estado: EstadoVentaCredito
        sucIds: [ID]
    ): [ConvenioSucursalIntegridad!]!
}
