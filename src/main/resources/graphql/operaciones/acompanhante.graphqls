type Acompanhante {
    hojaRuta: HojaRuta
    persona: Persona
}

input AcompanhanteInput {
    hojaRutaId: Int
    personaId: Int
}

extend type Query {
    acompanhantesPorHojaRuta(hojaRutaId: ID!): [Acompanhante]
}

extend type Mutation {
    saveAcompanhante(acompanhante: AcompanhanteInput!): Acompanhante!
    deleteAcompanhante(hojaRutaId: ID!, personaId: ID!): Boolean!
}
