# Dashboard del modulo de devoluciones (aditivo). Todas las queries filtran por
# rango de fecha (obligatorio, formato del resto del modulo) y sucursal opcional.

type ResumenDevoluciones {
    total: Int
    conProveedor: Int
    sinProveedor: Int
    # CON_PROVEEDOR en PENDIENTE o SEPARADO: lo que falta retirar.
    pendientesRetiro: Int
    valorTotal: Float
    # Valor de las devoluciones SIN_PROVEEDOR (merma).
    valorMerma: Float
}

type DevolucionPorEstado {
    estado: String
    cantidad: Int
}

type TopProductoDevuelto {
    productoId: ID
    descripcion: String
    cantidad: Float
    valor: Float
}

type TopMotivoDevolucion {
    motivoId: ID
    descripcion: String
    items: Int
    cantidad: Float
}

type DevolucionSeriePunto {
    fecha: String
    cantidad: Int
    valor: Float
}

extend type Query {
    resumenDevoluciones(fechaInicio: String!, fechaFin: String!, sucursalId: ID): ResumenDevoluciones
    devolucionesPorEstadoResumen(fechaInicio: String!, fechaFin: String!, sucursalId: ID): [DevolucionPorEstado]
    topProductosDevueltos(fechaInicio: String!, fechaFin: String!, sucursalId: ID, limite: Int): [TopProductoDevuelto]
    topMotivosDevolucion(fechaInicio: String!, fechaFin: String!, sucursalId: ID, limite: Int): [TopMotivoDevolucion]
    devolucionesSeriePorDia(fechaInicio: String!, fechaFin: String!, sucursalId: ID): [DevolucionSeriePunto]
}
