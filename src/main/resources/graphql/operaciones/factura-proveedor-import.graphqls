type FacturaProveedorImport {
    id: ID!
    origen: String!
    estado: String!
    nombreArchivo: String
    imagenMaster: ImagenMaster
    jsonCrudo: String
    jsonValidado: String
    tokensPrompt: Int
    tokensRespuesta: Int
    modeloIa: String
    errorMensaje: String
    pedidoId: Int
    usuario: Usuario
    creadoEn: Date
    modificadoEn: Date
}

type FacturaProveedorImportPage {
    getContent: [FacturaProveedorImport]
    getTotalElements: Int
    getTotalPages: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
}

type FacturaImportItemPreview {
    textoOcr: String
    codigoOcr: String
    cantidad: Float
    precioUnitario: Float
    descuento: Float
    totalItem: Float
    productoSugerido: Producto
    productoConfianza: String
    productoRazon: String
    candidatos: [Producto]
}

type FacturaImportPreview {
    importId: ID!
    estado: String
    emisorRuc: String
    emisorNombre: String
    # Datos adicionales del emisor (para precargar/sugerir actualizacion del proveedor). Opcionales.
    emisorNombreFantasia: String
    emisorDireccion: String
    emisorTelefono: String
    emisorEmail: String
    emisorDepartamento: String
    emisorDistrito: String
    emisorCiudad: String
    numeroFactura: String
    timbrado: String
    fechaEmision: String
    moneda: String
    totalGeneral: Float
    # Suma de totalItem de los items extraidos (control de cuadre)
    sumaItems: Float
    # true si sumaItems coincide con totalGeneral (dentro de tolerancia); false si no cuadran;
    # null si la factura no declara total o no hay items para comparar
    totalesCuadran: Boolean
    # Mensaje de advertencia cuando los totales no cuadran (ej: factura multipagina incompleta)
    totalesAdvertencia: String
    esLegal: Boolean
    proveedorSugerido: Proveedor
    proveedorConfianza: String
    proveedorRazon: String
    items: [FacturaImportItemPreview]
}

input ArchivoImportInput {
    archivoBase64: String!
    nombreArchivo: String!
    mimeType: String!
}

input ConfirmarFacturaImportItemInput {
    textoOcr: String
    codigoOcr: String
    productoId: Int
    presentacionId: Int
    cantidad: Float
    precioUnitario: Float
    descuento: Float
    omitir: Boolean
}

extend type Query {
    facturaProveedorImport(id: ID!): FacturaProveedorImport
    facturaProveedorImports(estado: String, page: Int, size: Int): FacturaProveedorImportPage
    facturaImportPreview(id: ID!): FacturaImportPreview
}

extend type Mutation {
    importarFacturaProveedor(archivos: [ArchivoImportInput!]!, usuarioId: Int!): FacturaProveedorImport!
    confirmarFacturaImport(importId: ID!, proveedorId: Int!, items: [ConfirmarFacturaImportItemInput!]!, tipoBoleta: String, crearPedido: Boolean!, usuarioId: Int!): FacturaProveedorImport!
}
