# Control de lotes.
#
# operaciones.lote (V155.3) es el maestro: unicidad (producto, numero_lote), y ahi viven las
# fechas y el estado. operaciones.movimiento_stock_lote es el ledger: el saldo por lote se deriva
# sumando sus filas, igual que el stock normal se deriva de movimiento_stock.

enum EstadoLote {
    # Disponible para la venta. Estado por defecto al recibir mercaderia.
    LIBERADO
    # Retenido a la espera de una definicion (control de calidad). No se vende.
    CUARENTENA
    # Bloqueado definitivamente (recall del proveedor, producto danado). No se vende.
    BLOQUEADO
}

type Lote {
    id: ID
    producto: Producto
    numeroLote: String
    fechaVencimiento: Date
    # Fecha por la que ordena FEFO: se calcula restando producto.diasVencimiento al vencimiento.
    fechaRetiro: Date
    fechaFabricacion: Date
    proveedor: Proveedor
    estado: EstadoLote
    observacion: String
    usuario: Usuario
    creadoEn: Date
    actualizadoEn: Date
}

type MovimientoStockLote {
    id: ID
    sucursalId: ID
    movimientoStockId: ID
    lote: Lote
    producto: Producto
    presentacion: Presentacion
    numeroLote: String
    cantidad: Float
    referencia: ID
    estado: Boolean
    usuario: Usuario
    creadoEn: Date
}

# Saldo disponible de un lote (agregado del ledger + datos del maestro).
type StockLote {
    loteId: ID
    productoId: ID
    # Solo lo completa buscarStockPorLote; stockPorLote lo deja null porque el llamador ya
    # conoce el producto.
    productoDescripcion: String
    # Solo los completa stockPorLote, que consulta una sucursal puntual. buscarStockPorLote
    # agrupa por lote y los deja null: el desglose se pide con stockLotePorSucursal.
    sucursalId: ID
    sucursalNombre: String
    numeroLote: String
    fechaVencimiento: Date
    fechaRetiro: Date
    estado: EstadoLote
    # De quien vino el lote. Solo lo completa buscarStockPorLote.
    proveedorNombre: String
    cantidadDisponible: Float
}

# Saldo de un lote expresado en la presentacion con la que carga el operador.
# El ledger lleva UNIDADES y las pantallas de transferencia cargan PRESENTACIONES; la conversion
# se resuelve en el backend para que sea la misma regla que se aplica al guardar la asignacion.
type StockLotePresentacion {
    loteId: ID
    numeroLote: String
    fechaVencimiento: Date
    fechaRetiro: Date
    estado: EstadoLote
    # Saldo en unidades.
    cantidadDisponible: Float
    # Presentaciones COMPLETAS que entran en el saldo: una caja de 6 es indivisible, asi que de
    # 65 unidades salen 10 cajas y no 10,833.
    cantidadDisponiblePresentacion: Float
    # Unidades que quedan fuera de esas presentaciones completas.
    unidadesSobrantes: Float
    unidadesPorPresentacion: Float
    presentacionDescripcion: String
}

type StockLotePresentacionPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [StockLotePresentacion]
}

# Saldo de un lote en una sucursal puntual. Es el desglose de una fila de StockLote.
type StockLoteSucursal {
    sucursalId: ID
    sucursalNombre: String
    cantidadDisponible: Float
}

# Un movimiento del historial de un lote. Es la lectura inversa del ledger: en vez de "que lotes
# tiene este movimiento", responde "que movimientos tocaron este lote".
type MovimientoLote {
    # Id de la fila del ledger. No es unico por si solo: la clave es (id, sucursalId).
    id: ID
    sucursalId: ID
    fecha: Date
    sucursalNombre: String
    # COMPRA, VENTA, AJUSTE o TRANSFERENCIA. Nulo si el movimiento padre ya no esta.
    tipoMovimiento: String
    # OJO: no es el documento, es el ITEM del documento, porque el ledger se escribe por item.
    # Para VENTA apunta a venta_item, para COMPRA a recepcion_mercaderia_item y para
    # TRANSFERENCIA a transferencia_item. Mostrarlo como documento manda a buscar un id que no
    # existe en la tabla que el operador va a abrir: para eso esta documentoId.
    referencia: ID
    # El documento al que pertenece ese item: la venta, la recepcion o la transferencia. Nulo
    # cuando el tipo no tiene documento resoluble o cuando el item ya no esta.
    documentoId: ID
    # Positiva si entro al lote, negativa si salio.
    cantidad: Float
    usuarioNombre: String
}

# Un cliente al que se le vendio un lote, con lo que se llevo sumado.
# NO es la venta completa del lote: la venta de mostrador va contra el cliente generico y no
# identifica a nadie, asi que queda afuera y su total se pide con resumenMostradorLote.
type ClienteLote {
    clienteId: ID
    clienteNombre: String
    clienteDocumento: String
    # Cuantas ventas distintas de este lote se le hicieron.
    ventas: Int
    # Unidades que se llevo, en positivo: el ledger las guarda negativas.
    cantidad: Float
    ultimaVenta: Date
}

type ClienteLotePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [ClienteLote]
}

# Lo que se vendio de un lote sin cliente identificado. Es el complemento honesto de
# clientesPorLote: sin este numero la lista de clientes se lee como si fuera todo lo que salio.
type MostradorLote {
    ventas: Int
    cantidad: Float
}

type MovimientoLotePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [MovimientoLote]
}

type StockLotePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [StockLote]
}

extend type Query {
    # Saldo por lote de un producto en una sucursal, ordenado por FEFO
    # (fecha de retiro mas proxima primero, lotes sin fecha al final).
    stockPorLote(productoId: ID!, sucursalId: ID!): [StockLote]

    # Mismo saldo que stockPorLote, pero convertido a la presentacion con la que carga el
    # operador y paginado. Con presentacionId nulo devuelve las cantidades en unidades, sin
    # convertir. numeroLote filtra por coincidencia parcial.
    stockPorLoteEnPresentacion(
        productoId: ID!
        sucursalId: ID!
        presentacionId: ID
        numeroLote: String
        page: Int = 0
        size: Int = 10
    ): StockLotePresentacionPage

    # Consulta general "donde tengo que": todos los filtros son opcionales. Devuelve una fila por
    # LOTE, con el saldo sumado de todas las sucursales; con sucursalId el total queda restringido
    # a esa sucursal.
    # vencimientoHasta filtra por COALESCE(fecha_retiro, fecha_vencimiento) <= fecha, para
    # responder "que se me vence antes de tal fecha". Formato yyyy-MM-dd.
    buscarStockPorLote(
        productoId: ID
        sucursalId: ID
        proveedorId: ID
        estado: EstadoLote
        numeroLote: String
        texto: String
        vencimientoHasta: String
        page: Int = 0
        size: Int = 20
    ): StockLotePage

    # Desglose por sucursal del saldo de un lote, para expandir una fila de "Stock por lotes".
    # Devuelve todas las sucursales ACTIVAS, con cantidad 0 en las que no tienen ese lote.
    stockLotePorSucursal(loteId: ID!): [StockLoteSucursal]

    # Lotes registrados de un producto, ordenados por FEFO. Incluye los bloqueados.
    lotesPorProducto(productoId: ID!): [Lote]

    # Desglose por lote de un movimiento de stock agregado.
    movimientoStockLotePorMovimiento(movimientoStockId: ID!, sucursalId: ID!): [MovimientoStockLote]

    # Historial de un lote: los movimientos que lo tocaron, del mas reciente al mas viejo.
    # Con sucursalId nulo devuelve el recorrido completo del lote por toda la red, que es lo que
    # hace falta en un recall: la compra que lo trajo, las transferencias que lo repartieron y las
    # ventas que lo sacaron.
    movimientosPorLote(
        loteId: ID!
        sucursalId: ID
        tipoMovimiento: TipoMovimiento
        page: Int = 0
        size: Int = 20
    ): MovimientoLotePage

    # A que clientes se le vendio el lote, agrupado por cliente y ordenado por lo que se llevaron.
    # Es lo que hace accionable el recall: bloquear el lote lo saca del mostrador, pero avisar
    # exige saber a quien llamar. Deja afuera la venta de mostrador.
    clientesPorLote(
        loteId: ID!
        sucursalId: ID
        page: Int = 0
        size: Int = 20
    ): ClienteLotePage

    # Cuanto del lote se vendio sin cliente identificado.
    resumenMostradorLote(loteId: ID!, sucursalId: ID): MostradorLote
}

extend type Mutation {
    # Cambia el estado de un lote. Es el mecanismo de recall: pasar a BLOQUEADO lo saca de FEFO y
    # del mostrador en todas las sucursales, sin tocar el stock fisico.
    cambiarEstadoLote(loteId: ID!, estado: EstadoLote!, observacion: String, usuarioId: ID): Lote
}
