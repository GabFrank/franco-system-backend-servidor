# Control de lotes.
#
# operaciones.lote (V155.3) es el maestro: unicidad (producto, numero_lote), y ahi viven las
# fechas y el estado. operaciones.movimiento_stock_lote es el ledger: el saldo por lote se deriva
# sumando sus filas, igual que el stock normal se deriva de movimiento_stock.

enum EstadoLote {
    # Disponible para la venta. Estado por defecto al recibir mercaderia.
    LIBERADO
    # Retenido a la espera de una definicion (control de calidad). No se vende.
    CUARENTENA
    # Bloqueado definitivamente (recall del proveedor, producto danado). No se vende.
    BLOQUEADO
}

type Lote {
    id: ID
    producto: Producto
    numeroLote: String
    fechaVencimiento: Date
    # Fecha por la que ordena FEFO: se calcula restando producto.diasVencimiento al vencimiento.
    fechaRetiro: Date
    fechaFabricacion: Date
    proveedor: Proveedor
    estado: EstadoLote
    observacion: String
    usuario: Usuario
    creadoEn: Date
    actualizadoEn: Date
}

type MovimientoStockLote {
    id: ID
    sucursalId: ID
    movimientoStockId: ID
    lote: Lote
    producto: Producto
    presentacion: Presentacion
    numeroLote: String
    cantidad: Float
    referencia: ID
    estado: Boolean
    usuario: Usuario
    creadoEn: Date
}

# Saldo disponible de un lote en una sucursal (agregado del ledger + datos del maestro).
type StockLote {
    loteId: ID
    productoId: ID
    # Solo lo completa buscarStockPorLote; stockPorLote lo deja null porque el llamador ya
    # conoce el producto.
    productoDescripcion: String
    sucursalId: ID
    sucursalNombre: String
    numeroLote: String
    fechaVencimiento: Date
    fechaRetiro: Date
    estado: EstadoLote
    cantidadDisponible: Float
}

type StockLotePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [StockLote]
}

extend type Query {
    # Saldo por lote de un producto en una sucursal, ordenado por FEFO
    # (fecha de retiro mas proxima primero, lotes sin fecha al final).
    stockPorLote(productoId: ID!, sucursalId: ID!): [StockLote]

    # Consulta general "donde tengo que": todos los filtros son opcionales.
    # vencimientoHasta filtra por COALESCE(fecha_retiro, fecha_vencimiento) <= fecha, para
    # responder "que se me vence antes de tal fecha". Formato yyyy-MM-dd.
    buscarStockPorLote(
        productoId: ID
        sucursalId: ID
        estado: EstadoLote
        numeroLote: String
        texto: String
        vencimientoHasta: String
        page: Int = 0
        size: Int = 20
    ): StockLotePage

    # Lotes registrados de un producto, ordenados por FEFO. Incluye los bloqueados.
    lotesPorProducto(productoId: ID!): [Lote]

    # Desglose por lote de un movimiento de stock agregado.
    movimientoStockLotePorMovimiento(movimientoStockId: ID!, sucursalId: ID!): [MovimientoStockLote]
}

extend type Mutation {
    # Cambia el estado de un lote. Es el mecanismo de recall: pasar a BLOQUEADO lo saca de FEFO y
    # del mostrador en todas las sucursales, sin tocar el stock fisico.
    cambiarEstadoLote(loteId: ID!, estado: EstadoLote!, observacion: String, usuarioId: ID): Lote
}
