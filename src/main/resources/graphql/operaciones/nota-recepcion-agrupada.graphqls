# Types
type NotaRecepcionAgrupada {
    id: ID!
    proveedor: Proveedor
    sucursal: Sucursal
    creadoEn: Date
    usuario: Usuario
    cantNotas: Int
    estado: NotaRecepcionAgrupadaEstado
    solicitudPago: SolicitudPago
}

# Inputs
input NotaRecepcionAgrupadaInput {
    id: ID
    proveedorId: ID
    sucursalId: ID
    usuarioId: ID
    creadoEn: String
    estado: NotaRecepcionAgrupadaEstado
}

# Pagination Type (if needed)
type NotaRecepcionAgrupadaPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [NotaRecepcionAgrupada]
    getPageable: Pageable
}

# Queries
extend type Query {
    notaRecepcionListPorUsuarioId(id: ID!, page: Int!, size: Int!): NotaRecepcionAgrupadaPage
    notaRecepcionAgrupadaPorId(id: ID!): NotaRecepcionAgrupada
    notaRecepcionListPorProveedorId(id: ID!, page: Int!, size: Int!): NotaRecepcionAgrupadaPage
    pedidoRecepcionProductoPorNotaRecepcionAgrupada( id: ID!, estado: PedidoRecepcionProductoEstado, page: Int = 0,size: Int = 10 ): PedidoRecepcionProductoPage
    pedidoRecepcionProductoPorNotaRecepcionAgrupadaAndProducto(notaRecepcionAgrupadaId: ID!, productoId: ID!, estado: PedidoRecepcionProductoEstado): PedidoRecepcionProductoDto

}

# Mutations
extend type Mutation {
    saveNotaRecepcionAgrupada(entity: NotaRecepcionAgrupadaInput!): NotaRecepcionAgrupada!
    recepcionProductoNotaRecepcionAgrupada(notaRecepcionAgrupadaId: ID!, productoId: ID!, sucursalId: ID!, cantidad: Float!): Boolean
    finalizarRecepcion(id: ID!): NotaRecepcionAgrupada
    reabrirRecepcion(id: ID!): NotaRecepcionAgrupada
    solicitarPagoNotaRecepcionAgrupada(id: ID!): SolicitudPago
}

enum NotaRecepcionAgrupadaEstado {
    EN_RECEPCION,
    CONCLUIDO,
    CANCELADO
}

type PedidoRecepcionProductoDto {
    producto: Producto
    totalCantidadARecibirPorUnidad: Float
    totalCantidadRecibidaPorUnidad: Float
    estado: PedidoRecepcionProductoEstado
}

type PedidoRecepcionProductoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [PedidoRecepcionProductoDto]
    getPageable: Pageable
}

enum PedidoRecepcionProductoEstado {
    PENDIENTE
    RECIBIDO
    RECIBIDO_PARCIALMENTE
}