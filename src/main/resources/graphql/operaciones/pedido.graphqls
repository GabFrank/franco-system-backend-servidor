type Pedido {
    id:ID
    proveedor: Proveedor
    vendedor: Vendedor
    formaPago: FormaPago
    tipoBoleta: String
    moneda: Moneda
    plazoCredito: Int
    creadoEn: Date
    usuario: Usuario
    sucursalEntregaList: [PedidoSucursalEntrega]
    sucursalInfluenciaList: [PedidoSucursalInfluencia]
    procesoEtapas: [ProcesoEtapa]
}

type PedidoResumen {
    pedidoId: ID
    etapaActual: ProcesoEtapa
    cantidadItems: Int
    valorTotal: Float
    valorTotalPedido: Float
    cantidadItemsConDistribucionCompleta: Int
    cantidadItemsPendientesDistribucion: Int
}

input PedidoInput {
    id:ID
    proveedorId: Int
    vendedorId: Int
    formaPagoId: Int
    tipoBoleta: String
    monedaId: Int
    plazoCredito: Int
    creadoEn: Date
    usuarioId: Int
}

type PedidoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Pedido]
    getPageable: Pageable
}

extend type Query {
    pedido(id:ID!):Pedido
    pedidos(page:Int = 0, size:Int = 10):[Pedido]!
    # filterPedidos(idPedido:ID, numeroNotaRecepcion:Int, sucursalId: Int, inicio: String, fin: String, proveedorId: Int, vendedorId: Int, formaPagoId: Int, productoId: Int, page: Int, size: Int):PedidoPage
    countPedido: Int
    pedidosWithFilters(sucursalId: Int, productoId: Int, proveedorId: Int, estado: String, creadoDesde: String, creadoHasta: String, page: Int, size: Int): PedidoPage
    
    # New step tracking queries
    etapaActualDelPedido(pedidoId:ID!): String
    progresoPedido(pedidoId:ID!): Int
    getPedidoResumen(pedidoId:ID!): PedidoResumen
    
    # Recepción Física queries
    getSucursalesDisponiblesRecepcionFisica(pedidoId:ID!): [Sucursal]!
    getSucursalesDisponiblesRecepcionFisicaSimple(pedidoId:ID!): [Sucursal]!
}

extend type Mutation {
    savePedido(entity: PedidoInput!): Pedido!
    savePedidoFull(
        entity: PedidoInput!
        fechaEntregaList: [String]
        sucursalEntregaList: [Int]
        sucursalInfluenciaList: [Int]
        usuarioId: Int
    ): Pedido!
    deletePedido(id: ID!): Boolean!
    finalizarCreacionPedido(pedidoId: ID!): Pedido!
    finalizarRecepcionNotas(pedidoId: ID!): Pedido!
}




