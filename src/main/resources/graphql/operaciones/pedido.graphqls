type Pedido {
    id:ID
    proveedor: Proveedor
    vendedor: Vendedor
    formaPago: FormaPago
    tipoBoleta: String
    moneda: Moneda
    plazoCredito: Int
    estado: PedidoEstado
    creadoEn: Date
    usuario: Usuario
}

input PedidoInput {
    id:ID
    proveedorId: Int
    vendedorId: Int
    formaPagoId: Int
    tipoBoleta: String
    monedaId: Int
    plazoCredito: Int
    estado: PedidoEstado
    creadoEn: Date
    usuarioId: Int
}

type PedidoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Pedido]
    getPageable: Pageable
}

extend type Query {
    pedido(id:ID!):Pedido
    pedidos(page:Int = 0, size:Int = 10):[Pedido]!
    filterPedidos(idPedido:ID, numeroNotaRecepcion:Int ,estado: PedidoEstado, sucursalId: Int, inicio: String, fin: String, proveedorId: Int, vendedorId: Int, formaPagoId: Int, productoId: Int, page: Int, size: Int):PedidoPage
    countPedido: Int
    
    # New step tracking queries
    etapaActualDelPedido(pedidoId:ID!): String
    progresoPedido(pedidoId:ID!): Int
}

extend type Mutation {
    savePedido(entity:PedidoInput!):Pedido!
    savePedidoFull(entity:PedidoInput!, fechaEntregaList: [String], sucursalEntregaList: [Int], sucursalInfluenciaList: [Int], usuarioId: Int):Pedido!
    deletePedido(id:ID!):Boolean!
    finalizarPedido(id:ID, estado:PedidoEstado): Pedido
    
    # New step tracking mutations
    finalizarCreacionPedido(pedidoId:ID!): Pedido
}

enum PedidoEstado {
    ABIERTO,
    ACTIVO,
    EN_RECEPCION_NOTA,
    EN_RECEPCION_MERCADERIA,
    EN_SOLICITUD_PAGO,
    CONCLUIDO,
    CANCELADO
}


