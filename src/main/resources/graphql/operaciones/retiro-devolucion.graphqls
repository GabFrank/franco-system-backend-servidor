# Retiro consolidado de devoluciones por proveedor + remito PDF (FASE A).
# Todo aditivo: no modifica types/queries/mutations existentes de devolucion.

type RetiroLineaConsolidada {
    productoId: ID
    codigo: String
    descripcion: String
    presentacion: String
    cantidadTotal: Float
}

type RetiroCaja {
    identificador: String
    devolucionId: ID
    productoId: ID
    descripcion: String
    cantidad: Float
    lote: String
    vencimiento: Date
    # Factor de la presentacion ("x1", "x12").
    presentacion: String
}

# Una devolucion lista para retirar con sus productos. Es lo que se escanea:
# su etiqueta lleva un solo QR con el identificador.
type RetiroDevolucionResumen {
    devolucionId: ID
    identificador: String
    estado: String
    productos: [RetiroCaja]
}

type RetiroSucursalGrupo {
    sucursalId: ID
    sucursalNombre: String
    lineas: [RetiroLineaConsolidada]
    cajas: [RetiroCaja]
    devolucionIds: [ID]
    devoluciones: [RetiroDevolucionResumen]
}

type RetiroProveedorConsolidado {
    proveedorId: ID
    proveedorNombre: String
    fecha: Date
    grupos: [RetiroSucursalGrupo]
}

type RetiroDevolucionResultado {
    id: ID
    ok: Boolean
    mensaje: String
}

type RetiroBloqueResultado {
    resultados: [RetiroDevolucionResultado]
}

extend type Query {
    retiroProveedorConsolidado(proveedorId: ID!, sucursalId: ID): RetiroProveedorConsolidado
    remitoRetiroProveedor(devolucionIds: [ID!]!): String
    # PDF A4 (Base64) con la etiqueta de separado de una devolucion: una sola, con un QR
    # y la lista de productos.
    etiquetasSeparadoPdf(devolucionId: ID!): String
}

extend type Mutation {
    retirarDevolucionesEnBloque(devolucionIds: [ID!]!, usuarioId: ID): RetiroBloqueResultado
    # Colecta interna: envia devoluciones SEPARADAS a un deposito (pasan a COLECTADO).
    colectarDevolucion(devolucionId: ID!, sucursalDestinoId: ID!, usuarioId: ID): Devolucion
    colectarDevolucionesEnBloque(devolucionIds: [ID!]!, sucursalDestinoId: ID!, usuarioId: ID): RetiroBloqueResultado
    # anchoMm: ancho del papel termico (58 u 80). Null asume 58.
    imprimirTicketRetiroProveedor(devolucionIds: [ID!]!, printerName: String, anchoMm: Int): Boolean
    # Etiqueta de separado en ticket termico: una por devolucion, con un QR y la lista de productos.
    imprimirEtiquetasSeparado(devolucionId: ID!, printerName: String, anchoMm: Int): Boolean
}
