type SolicitudPago {
    id: ID
    proveedor: Proveedor
    montoTotal: Float
    moneda: Moneda
    formaPago: FormaPago
    estado: SolicitudPagoEstado
    creadoEn: Date
    usuario: Usuario
    pago: Pago
}

input SolicitudPagoInput {
    id: ID
    proveedorId: Int
    montoTotal: Float
    monedaId: Int
    formaPagoId: Int
    estado: SolicitudPagoEstado
    creadoEn: Date
    usuarioId: Int
    pagoId: Int
}

input SolicitudPagoMultipleRecepcionesInput {
    proveedorId: Int
    descripcion: String
    recepcionMercaderiaIds: [Int]
    usuarioId: Int
}

type SolicitudPagoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [SolicitudPago]
    getPageable: Pageable
}

extend type Query {
    solicitudPago(id: ID!): SolicitudPago
    solicitudPagoPorUsuarioId(id: ID!): [SolicitudPago]
    solicitudPagoConFiltros(
        solicitudPagoId: ID, 
        proveedorId: ID,
        estado: SolicitudPagoEstado, 
        fechaInicio: String, 
        fechaFin: String, 
        page: Int = 0, 
        size: Int = 20
    ): SolicitudPagoPage
    countSolicitudPago: Int
}

extend type Mutation {
    saveSolicitudPago(entity: SolicitudPagoInput!): SolicitudPago!
    deleteSolicitudPago(id: ID!): Boolean!
    
    # Nuevas funcionalidades del refactor
    crearSolicitudPagoMultipleRecepciones(entity: SolicitudPagoMultipleRecepcionesInput!): SolicitudPago!
    procesarPagoSolicitud(solicitudPagoId: ID!): SolicitudPago!
}

enum SolicitudPagoEstado {
    PENDIENTE
    PARCIAL
    CONCLUIDO
    CANCELADO
}
