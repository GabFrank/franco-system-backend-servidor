type TransferenciaItem {
    id:ID!
    transferencia: Transferencia
    presentacionPreTransferencia: Presentacion
    presentacionPreparacion: Presentacion
    presentacionTransporte: Presentacion
    presentacionRecepcion: Presentacion
    cantidadPreTransferencia: Float
    cantidadPreparacion: Float
    cantidadTransporte: Float
    cantidadRecepcion: Float
    observacionPreTransferencia: String
    observacionPreparacion: String
    observacionTransporte: String
    observacionRecepcion: String
    vencimientoPreTransferencia: Date
    vencimientoPreparacion: Date
    vencimientoTransporte: Date
    vencimientoRecepcion: Date
    motivoModificacionPreTransferencia: TransferenciaItemMotivoModificacion
    motivoModificacionPreparacion: TransferenciaItemMotivoModificacion
    motivoModificacionTransporte: TransferenciaItemMotivoModificacion
    motivoModificacionRecepcion: TransferenciaItemMotivoModificacion
    motivoRechazoPreTransferencia: TransferenciaItemMotivoRechazo
    motivoRechazoPreparacion: TransferenciaItemMotivoRechazo
    motivoRechazoTransporte: TransferenciaItemMotivoRechazo
    motivoRechazoRecepcion: TransferenciaItemMotivoRechazo
    activo: Boolean
    poseeVencimiento: Boolean
    usuario: Usuario
    creadoEn: Date
    vencimientoVerificado: Boolean
    # Lotes elegidos a mano para este item. Vacio = el desglose se resuelve por FEFO.
    # Se resuelve en TransferenciaItemResolver, no es una asociacion de la entidad.
    lotesAsignados: [TransferenciaItemLote]
}

# Etapa en la que se eligieron los lotes. PREPARACION pisa a PRE_TRANSFERENCIA al momento de
# resolver el desglose, pero ambas quedan guardadas para poder auditar que se habia pedido.
enum EtapaAsignacionLote {
    PRE_TRANSFERENCIA
    PREPARACION
}

# Una porcion de la cantidad de un item, asignada a un lote concreto.
# Es la INTENCION del operador: el desglose real del stock vive en movimiento_stock_lote.
type TransferenciaItemLote {
    id: ID
    loteId: ID
    numeroLote: String
    # En UNIDADES, como vive en el ledger.
    cantidad: Float
    # La misma cantidad en la presentacion del item, ya convertida por el backend.
    cantidadPresentacion: Float
    etapa: EtapaAsignacionLote
    fechaVencimiento: Date
    fechaRetiro: Date
    estadoLote: EstadoLote
    usuario: Usuario
    creadoEn: Date
}

type TransferenciaItemAlerta {
    transferenciaItemId: ID!
    alertaVencido: Boolean
    alertaAveriado: Boolean
    fechaVencimientoReferencia: Date
}

input TransferenciaItemInput {
    id:ID
    transferenciaId: Int
    presentacionPreTransferenciaId: Int
    presentacionPreparacionId: Int
    presentacionTransporteId: Int
    presentacionRecepcionId: Int
    cantidadPreTransferencia: Float
    cantidadPreparacion: Float
    cantidadTransporte: Float
    cantidadRecepcion: Float
    observacionPreTransferencia: String
    observacionPreparacion: String
    observacionTransporte: String
    observacionRecepcion: String
    vencimientoPreTransferencia: String
    vencimientoPreparacion: String
    vencimientoTransporte: String
    vencimientoRecepcion: String
    motivoModificacionPreTransferencia: TransferenciaItemMotivoModificacion
    motivoModificacionPreparacion: TransferenciaItemMotivoModificacion
    motivoModificacionTransporte: TransferenciaItemMotivoModificacion
    motivoModificacionRecepcion: TransferenciaItemMotivoModificacion
    motivoRechazoPreTransferencia: TransferenciaItemMotivoRechazo
    motivoRechazoPreparacion: TransferenciaItemMotivoRechazo
    motivoRechazoTransporte: TransferenciaItemMotivoRechazo
    motivoRechazoRecepcion: TransferenciaItemMotivoRechazo
    activo: Boolean
    poseeVencimiento: Boolean
    usuarioId: Int
    creadoEn: String
    vencimientoVerificado: Boolean
    # null  -> no toca la asignacion existente (es lo que manda todo cliente que no sabe de lotes)
    # []    -> borra la asignacion de esa etapa y el item vuelve a resolverse por FEFO
    # lista -> reemplaza la asignacion de esa etapa
    lotesAsignados: [TransferenciaItemLoteInput]
    # Etapa a la que corresponde lotesAsignados. Se ignora si la lista viene null.
    etapaAsignacionLote: EtapaAsignacionLote
}

input TransferenciaItemLoteInput {
    loteId: ID!
    # EN PRESENTACIONES, la misma unidad que carga el operador y que devuelve
    # stockPorLoteEnPresentacion. El backend la convierte a unidades antes de guardar, usando la
    # presentacion del item para la etapa correspondiente.
    cantidad: Float!
}

type TransferenciaItemPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getPageable: Pageable
    getContent: [TransferenciaItem]
}

extend type Query {
    transferenciaItem(id:ID!):TransferenciaItem
    transferenciaItems(page:Int = 0, size:Int = 10):[TransferenciaItem]!
    transferenciaItensPorTransferenciaId(id: ID!, page:Int = 0, size:Int = 10):TransferenciaItemPage!
    transferenciaItensPorTransferenciaIdWithFilter(id: ID, name: String, page:Int = 0, size:Int = 10):TransferenciaItemPage!
    alertasTransferenciaItems(transferenciaId: ID!, itemIds: [ID!]!): [TransferenciaItemAlerta]!
}

extend type Mutation {
    saveTransferenciaItem(transferenciaItem:TransferenciaItemInput!, precioCosto: Float):TransferenciaItem!
    deleteTransferenciaItem(id:ID!):Boolean!
    verificarProducto(id: ID!, vencimientoVerificado: Boolean!): TransferenciaItem!
    # Vacia las columnas de una etapa del item. En saveTransferenciaItem la ausencia de un campo
    # significa "no lo toques", asi que limpiar necesita ser un pedido explicito.
    # Etapas validas: PREPARACION_MERCADERIA, TRANSPORTE_VERIFICACION, RECEPCION_EN_VERIFICACION.
    desconfirmarTransferenciaItem(id: ID!, etapa: EtapaTransferencia!): TransferenciaItem!
}

enum TransferenciaItemMotivoRechazo {
    FALTA_PRODUCTO,
    PRODUCTO_AVERIADO,
    PRODUCTO_VENCIDO,
    PRODUCTO_EQUIVOCADO
}

enum TransferenciaItemMotivoModificacion {
    CANTIDAD_INCORRECTA,
    VENCIMIENTO_INCORRECTO,
    PRESENTACION_INCORRECTA
}





