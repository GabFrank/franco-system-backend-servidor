type VentaItem {
    id:ID!
    venta: Venta
    producto: Producto
    presentacion: Presentacion
    cantidad: Float
    precioCosto: Float
    precio: Float
    precioVenta: PrecioPorSucursal
    valorDescuento: Float
    unidadMedida: UnidadMedida
    creadoEn: Date
    usuario: Usuario
    valorTotal: Float
    sucursalId: Int
}

input VentaItemInput {
    id:ID
    ventaId: Int
    productoId: Int
    productoDescripcion: String
    presentacionId: Int
    presentacionDescripcion: String
    cantidad: Float
    precioCosto: Float
    precioVentaId: Int
    precioVenta: Float
    valorDescuento: Float
    usuarioId: Int
    sucursalId: Int
}

type ProductoVendidoEstadistica {
    productoId: ID
    descripcion: String
    cantidad: Float
    totalMonto: Float
    porcentaje: Float
}

extend type Query {
    ventaItem(id:ID!, sucId: ID):VentaItem
    ventaItems(page:Int = 0, size:Int = 10, sucId: ID):[VentaItem]!
    countVentaItem: Int
    ventaItemListPorVentaId(id:ID!, sucId: ID):[VentaItem]
    productosMasVendidos(inicio: String, fin: String, limit: Int, sucursalId: ID, familiaId: ID): [ProductoVendidoEstadistica]
}

extend type Mutation {
    saveVentaItem(ventaItem:VentaItemInput!):VentaItem!
    deleteVentaItem(id:ID!, sucId: ID):Boolean!
}


