type Persona {
    id:ID!,
    nombre: String,
    apodo: String,
    nacimiento: Date,
    documento: String,
    email: String,
    sexo: String,
    direccion: String,
    ciudad: Ciudad,
    "Pais del receptor para SIFEN (#666). Nulo = Paraguay."
    pais: Pais,
    telefono: String,
    socialMedia: String,
    imagenes: String,
    creadoEn: Date,
    usuario: Usuario,
    isFuncionario: Boolean
    isCliente: Boolean
    isProveedor: Boolean
    isUsuario: Boolean
    embeddingFacial: String
}

input PersonaInput {
    id:ID
    nombre: String
    apodo: String
    documento: String
    nacimiento: String
    sexo: String
    direccion: String
    email: String
    ciudadId: Int
    "Pais del receptor (#666). Si viene, reemplaza el guardado; sin el campo, no se toca."
    paisId: Int
    telefono: String
    socialMedia: String
    imagenes: String
    creadoEn: Date
    usuarioId: Int
    isFuncionario: Boolean
    isCliente: Boolean
    isProveedor: Boolean
}

type BackfillPaisFilial {
    sucursalId: ID
    nombre: String
    "OK, SIN_IP, SIN_CONEXION o SIN_COLUMNA"
    estado: String
    personasConPais: Int
    error: String
}

type BackfillPaisResultado {
    grabados: Int
    "Ya tenian pais en el central (o no existen): no se tocan"
    sinCambios: Int
    idsGrabados: [ID]
    "Personas con paises distintos segun la filial: no se graban"
    conflictos: [ID]
    "Personas cuyo pais de la filial no existe en el central"
    paisesDesconocidos: [ID]
    filiales: [BackfillPaisFilial]
    completo: Boolean
}

type PersonaPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Persona]
}

extend type Query {
    persona(id:ID!):Persona
    personaSearch(texto:String):[Persona]
    personaSearchPage(texto: String, page: Int, size: Int): PersonaPage
    personas(page:Int = 0, size:Int = 10):[Persona]!
    countPersona:Int
    personaPorDocumento(texto:String):Persona
}

extend type Mutation {
    savePersona(persona:PersonaInput!):Persona!
    deletePersona(id:ID!):Boolean!
    "Sube al central el pais que las cajas cargaron en las filiales (#666). Solo ADMIN. Idempotente: correrlo de nuevo hasta que completo sea true."
    backfillPaisPersonas: BackfillPaisResultado!
#    updatePersona(id:ID!, persona:PersonaInput!):Persona!
}

