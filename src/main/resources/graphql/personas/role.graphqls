type Role {
    id:ID!
    nombre: String
    creadoEn: Date
    usuario: Usuario
}

input RoleInput {
    id:ID
    nombre: String
    usuarioId: Int
}

extend type Query {
    role(id:ID!):Role
    roles(page:Int, size:Int):[Role]!
    countRole:Int
    # Lista paginada con filtro por id o nombre. Query aparte: `roles` sigue trayendo
    # la lista completa para los selectores.
    rolesPaginated(texto: String, page: Int, size: Int): RolePage
}

type RolePage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Role]
}

extend type Mutation {

    saveRole(role:RoleInput!):Role!

    deleteRole(id:ID!):Boolean!
}

