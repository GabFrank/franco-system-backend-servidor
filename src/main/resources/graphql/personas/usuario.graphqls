type Usuario {
    id:ID!
    persona: Persona
    password: String
    nickname: String
    creadoEn: Date
    usuario: Usuario
    roles: [String]
    activo: Boolean
    inicioSesion: InicioSesion
}

type UsuarioSimilitud {
    usuario: Usuario
    similitud: Float
}

type UsuarioPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [Usuario]
    getPageable: Pageable
}

input UsuarioInput {
    id:ID
    personaId: Int
    password: String
    nickname: String
    usuarioId: Int
    activo: Boolean
}

extend type Query {
    usuario(id:ID!):Usuario
    usuarioPorPersonaId(id:ID!):Usuario
    usuarios(page:Int = 0, size:Int = 10):[Usuario]!
    countUsuario:Int
    usuarioSearch(texto:String):[Usuario]
    usuarioSearchPage(texto:String, page:Int = 0, size:Int = 10):UsuarioPage
    verificarUsuario(texto:String): Boolean

    getUsuarioImages(id:ID!, type:String!):[String]
    isUserFaceAuth(id:ID!):Int
    usuariosActivos:[Usuario]
    usuarioPorEmbedding(embedding: [Float], excludeIds: [Int]): UsuarioSimilitud
}

extend type Mutation {
    saveUsuario(usuario:UsuarioInput!):Usuario!
    deleteUsuario(id:ID!):Boolean!
    saveUsuarioImage(id:ID!, type:String!, image:String!, embedding: [Float]):Boolean
}

