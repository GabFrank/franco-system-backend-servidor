type Codigo {
    id: ID
    codigo: String
    principal: Boolean
    usuario: Usuario
    activo: Boolean
    presentacion: Presentacion
    creadoEn: Date
}

input CodigoInput {
    id: ID
    codigo: String
    principal: Boolean
    usuarioId: Int
    activo: Boolean
    presentacionId: Int
}

extend type Query {
    codigo(id:ID!):Codigo
    codigos(page:Int = 0, size:Int = 10):[Codigo]!
    countCodigo: Int
    codigoPorCodigo(texto:String):[Codigo]
    codigosPorPresentacionId(id:Int):[Codigo]
    """
    Genera el próximo EAN-13 interno (prefijo 2199 + secuencia + check digit).
    No lo persiste: el cliente lo guarda con saveCodigo. Se imprime como CODE128 en la app.
    """
    generarCodigoInterno: String!
}

extend type Mutation {
    saveCodigo(codigo:CodigoInput!):Codigo!
    deleteCodigo(id:ID!):Boolean!
}


