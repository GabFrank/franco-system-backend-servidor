type CostoPorProducto {
    id:ID!
    sucursal: Sucursal
    producto: Producto
    movimientoStock: MovimientoStock
    ultimoPrecioCompra: Float
    ultimoPrecioVenta: Float
    costoMedio: Float
    moneda: Moneda
    cotizacion: Float
    existencia: Float
    creadoEn: Date
    usuario: Usuario
    "Moneda de costeo (modulo COSTOS) de los dos campos siguientes. Los de arriba siguen en la moneda de la empresa."
    monedaCosteo: Moneda
    "Costo medio en monedaCosteo. En filas anteriores a V259.5, el costo de la empresa a la cotizacion de compras de vigente_desde."
    costoMedioCosteo: Float
    "Ultimo precio de compra en monedaCosteo, con la misma regla."
    ultimoPrecioCompraCosteo: Float
}

input CostoPorProductoInput {
    id:ID
    sucursalId: Int
    productoId: Int
    movimientoStockId: Int
    ultimoPrecioCompra: Float
    ultimoPrecioVenta: Float
    costoMedio: Float
    monedaId: Int
    cotizacion: Float
    existencia: Float
    creadoEn: Date
    usuarioId: Int
}

type CostoPorProductoPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [CostoPorProducto]
    getPageable: Pageable
}

extend type Query {
    costosPorProductoId(id:ID!, page: Int, size: Int):CostoPorProductoPage!
}

extend type Mutation {
    saveCostoPorProducto(costoPorProducto:CostoPorProductoInput!):CostoPorProducto!
    deleteCostoPorProducto(id:ID!):Boolean!
}


