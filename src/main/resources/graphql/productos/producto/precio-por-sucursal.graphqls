type PrecioPorSucursal {
    id: ID!
    presentacion: Presentacion
    tipoPrecio: TipoPrecio
    sucursal: Sucursal
    precio: Float
    creadoEn: Date
    usuario: Usuario
    principal: Boolean
    activo: Boolean
    "Moneda del precio. null = la moneda de la empresa (principal)."
    moneda: Moneda
}

input PrecioPorSucursalInput {
    id: ID
    presentacionId: Int
    tipoPrecioId: Int
    sucursalId: Int
    precio: Float
    usuarioId: Int
    principal: Boolean
    activo: Boolean
    "null en un alta = la moneda del modulo PRECIOS; en una edicion = conserva la guardada."
    monedaId: Int
}

extend type Query {
    precioPorSucursal(id:ID!):PrecioPorSucursal
    preciosPorSucursal(page:Int = 0, size:Int = 10):[PrecioPorSucursal]!
    countPrecioPorSucursal: Int
    precioPorSucursalPorPresentacionId(id:Int): [PrecioPorSucursal]
}

extend type Mutation {
    savePrecioPorSucursal(precioPorSucursal:PrecioPorSucursalInput!):PrecioPorSucursal!
    deletePrecioPorSucursal(id:ID!):Boolean!
}



"Un precio de venta que no esta en la moneda de la empresa (V260.5)."
type PrecioEnOtraMoneda {
    precioId: ID!
    moneda: Moneda!
}

extend type Query {
    "Los precios en otra moneda que la de la empresa. Un cliente la pide aparte y la cachea: contra un central viejo falla y todo es de la moneda de la empresa."
    preciosEnOtraMoneda: [PrecioEnOtraMoneda]!
}
