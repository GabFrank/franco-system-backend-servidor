enum MotivoEgreso {
    RENUNCIA
    DESPIDO_JUSTIFICADO
    DESPIDO_INJUSTIFICADO
    MUTUO_ACUERDO
    JUBILACION
    FALLECIMIENTO
    OTRO
}

enum LiquidacionFinalEstado {
    BORRADOR
    APROBADA
    PAGADA
    ANULADA
}

enum LiquidacionFinalConcepto {
    INDEMNIZACION
    VACACIONES_NO_GOZADAS
    AGUINALDO_PROPORCIONAL
}

type LiquidacionFinalItem {
    id: ID!
    concepto: LiquidacionFinalConcepto
    descripcion: String
    monto: Float
}

type LiquidacionFinal {
    id: ID!
    funcionario: Funcionario
    fechaEgreso: String
    motivoEgreso: MotivoEgreso
    antiguedadDias: Int
    antiguedadMeses: Int
    antiguedadAnios: Int
    salarioPromedio: Float
    indemnizacionAplica: Boolean
    indemnizacionMonto: Float
    diasVacacionesNoGozadas: Int
    montoVacacionesNoGozadas: Float
    aguinaldoProporcional: Float
    totalLiquidado: Float
    moneda: Moneda
    estado: LiquidacionFinalEstado
    aprobadoPor: Usuario
    fechaAprobacion: Date
    fechaPago: Date
    observacion: String
    items: [LiquidacionFinalItem]
    creadoEn: Date
}

extend type Query {
    liquidacionFinal(id: ID!): LiquidacionFinal
    liquidacionesFinalesPorFuncionario(funcionarioId: ID!): [LiquidacionFinal]
    liquidacionFinalItems(liquidacionFinalId: ID!): [LiquidacionFinalItem]
}

extend type Mutation {
    generarLiquidacionFinal(funcionarioId: ID!, motivoEgreso: MotivoEgreso!, fechaEgreso: String, monedaId: ID): LiquidacionFinal
    aprobarLiquidacionFinal(id: ID!, aprobadoPorId: ID): LiquidacionFinal
    volverBorradorLiquidacionFinal(id: ID!): LiquidacionFinal
    pagarLiquidacionFinal(id: ID!, cajaVirtualId: ID!): LiquidacionFinal
    anularLiquidacionFinal(id: ID!): LiquidacionFinal
}
