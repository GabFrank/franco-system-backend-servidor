extend type Query {
    # ciudadId: filtra por la ciudad de la sucursal del funcionario. sinCiudad=true trae
    # solo a los que no tienen sucursal asignada (y por lo tanto no caen en ninguna ciudad).
    # Ambos en null/false = nomina general, como estaba.
    reporteNominaMes(periodo: String!, ciudadId: ID, sinCiudad: Boolean): String
    reporteResumenIps(periodo: String!): String
    imprimirReciboFinal(id: ID!, anchoMm: Int, escpos: Boolean): String
    reporteValesPendientes: String
    reportePrestamosActivos: String
    reporteAguinaldoAnual(anio: Int!): String
    # Recibos firmables por registro. anchoMm: null=PDF A4, 58/80=ticket. escpos=true → payload ESC/POS (para print-local del cliente).
    imprimirReciboVale(id: ID!, anchoMm: Int, escpos: Boolean): String
    imprimirReciboPenalizacion(id: ID!, anchoMm: Int, escpos: Boolean): String
    imprimirActaAdvertencia(id: ID!): String
    imprimirReciboAguinaldo(id: ID!, anchoMm: Int, escpos: Boolean): String
    imprimirReciboPrestamo(id: ID!, anchoMm: Int, escpos: Boolean): String
    imprimirReciboBono(id: ID!, anchoMm: Int, escpos: Boolean): String
}
