type VehiculoSucursal {
    id:ID!
    vehiculo: Vehiculo
    sucursal: Sucursal
    responsable: Funcionario
    creadoEn: Date
    usuario: Usuario
}

input VehiculoSucursalInput {
    id:ID
    vehiculoId: Int
    sucursalId: Int
    responsableId: Int
    usuarioId: Int
}

type VehiculoSucursalPage {
    getTotalPages: Int
    getTotalElements: Int
    getNumberOfElements: Int
    isFirst: Boolean
    isLast: Boolean
    hasNext: Boolean
    hasPrevious: Boolean
    getContent: [VehiculoSucursal]
    getPageable: Pageable
}

extend type Query {
    vehiculoSucursal(id:ID!):VehiculoSucursal
    vehiculosSucursal(page:Int = 0, size:Int = 10):[VehiculoSucursal]!
    countVehiculoSucursal: Int
    vehiculosSucursalByVehiculo(vehiculoId:ID!):[VehiculoSucursal]
    vehiculosSucursalBySucursal(sucursalId:ID!):[VehiculoSucursal]
    vehiculosSucursalSearchPage(sucursalId: ID, responsableId: ID, page: Int, size: Int): VehiculoSucursalPage
}

extend type Mutation {
    saveVehiculoSucursal(vehiculoSucursal:VehiculoSucursalInput!):VehiculoSucursal!
    deleteVehiculoSucursal(id:ID!):Boolean!
}

