			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="36" width="555" height="44"/>
				<textElement textAlignment="Justified"><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA["Recibi de la empresa " + ($P{empresa} != null ? $P{empresa} : "") + " la suma de " + ($P{totalEnLetras} != null ? $P{totalEnLetras} : "") + " (Gs. " + ($P{total} != null ? $P{total} : "") + ") en concepto de liquidacion final de haberes laborales."]]></textFieldExpression>
