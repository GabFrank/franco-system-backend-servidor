				<textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement>
				<textFieldExpression><![CDATA["Nombre y Apellido: " + ($P{funcionario} != null ? $P{funcionario} : "")]]></textFieldExpression>
